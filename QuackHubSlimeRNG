                    task.wait(0.5)
                end
                Window:Notify("Codes", "Redeemed all codes", 2)
            end,
        })

        -- [[ TAB: CREDITS ]]
        local CreditsTab = Window:CreateTab("Credits", "rbxassetid://10709751939")
        CreditsTab:CreateSection("Creator: Powder")
        CreditsTab:CreateSection("UI: Lu4ikk1")
        CreditsTab:CreateSection("Thanks for using Cryo Hub!")

        Window:Notify("Cryo Hub", "Successfully loaded!", 3)
    end,
})


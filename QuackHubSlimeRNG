                if v then
                    startAntiAfk()
                else
                    stopAntiAfk()
                end
            end,
        })

        MiscTab:CreateSection("Other")

        MiscTab:CreateButton({
            Title = "Redeem All Codes",
            Callback = function()
                if not codeRF then return end
                for _, code in ipairs({"2muchluck", "test", "gullible"}) do

local RANDOM_PARTS = {
	"Head", "UpperTorso", "LowerTorso", "HumanoidRootPart",
	"LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm",
	"LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg"
}
local lastTargetPart = {}
local silentTarget
local function pickRandomPart(char)
	local available = {}
	for _, name in ipairs(RANDOM_PARTS) do
		local p = char:FindFirstChild(name)
		if p and p:IsA("BasePart") then table.insert(available, p) end
	end
	if #available == 0 then return nil end
	return available[math.random(1, #available)]
end
local function getSilentTarget()
	local myChar = LocalPlayer.Character
	if not myChar then return nil end
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local myRoot = myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end
	local mousePos = UserInputService:GetMouseLocation()
	local camPos = cam.CFrame.Position
	local bestPart, bestScore = nil, math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr == LocalPlayer then continue end
		if Settings.SilentAimIgnoreFriends and LocalPlayer:IsFriendsWith(plr.UserId) then continue end
		local char = plr.Character
		if not char then continue end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then continue end
		local part
		if Settings.SilentAimRandomPart then
			local cached = lastTargetPart[plr]
			if cached and cached.Parent == char then part = cached
			else part = pickRandomPart(char) lastTargetPart[plr] = part end
		else
			part = char:FindFirstChild(Settings.SilentAimPart) or char:FindFirstChild("Head")
		end
		if not part then continue end
		if Settings.SilentAimWallCheck then
			local params = RaycastParams.new()
			params.FilterDescendantsInstances = { myChar, cam }
			params.FilterType = Enum.RaycastFilterType.Blacklist
			params.IgnoreWater = true
			local dir = part.Position - camPos
			local result = workspace:Raycast(camPos, dir, params)
			if result and result.Instance and not result.Instance:IsDescendantOf(char) then
				if (result.Position - camPos).Magnitude < dir.Magnitude - 1 then continue end
			end
		end
		local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
		if not onScreen then continue end
		local fovDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
		if fovDist > Settings.SilentAimFOV then continue end
		local score
		if Settings.SilentAimPriority == "Distance" then score = (part.Position - myRoot.Position).Magnitude
		elseif Settings.SilentAimPriority == "Health" then score = hum.Health
		else score = fovDist end
		if score < bestScore then bestScore = score bestPart = part end
	end
	for plr, part in pairs(lastTargetPart) do
		if not plr.Parent or not plr.Character or part.Parent ~= plr.Character then
			lastTargetPart[plr] = nil
		end
	end
	return bestPart
end
RunService.RenderStepped:Connect(function()
	if Settings.SilentAim then
		local ok, target = pcall(getSilentTarget)
		silentTarget = ok and target or nil
	else
		silentTarget = nil
	end
end)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
	local method = getnamecallmethod()
	if method == "Raycast" and self == Workspace
		and Settings.SilentAim and silentTarget and silentTarget.Parent then
		local args = { ... }
		local origin = args[1]
		local direction = args[2]
		if origin and direction then
			args[2] = (silentTarget.Position - origin).Unit * direction.Magnitude
			return oldNamecall(self, unpack(args))
		end
	end
	return oldNamecall(self, ...)
end))


-- FOV / Lighting / ESP / combat systems (full)
local FOVCircle
function updateFOVCircle()
	if FOVCircle then pcall(function() FOVCircle:Remove() end) FOVCircle = nil end
	if not (Settings.SilentAim and Settings.SilentAimFOVCircle) then return end
	if not Drawing or not Drawing.new then return end
	local ok, circle = pcall(function() return Drawing.new("Circle") end)
	if not ok or not circle then return end
	FOVCircle = circle
	FOVCircle.Visible = true
	FOVCircle.Thickness = 1.5
	FOVCircle.Transparency = 0.7
	FOVCircle.ZIndex = 10
	FOVCircle.Filled = false
	FOVCircle.NumSides = 64
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if not FOVCircle or not Settings.SilentAim then
			if conn then conn:Disconnect() end
			return
		end
		local cam = workspace.CurrentCamera
		if cam then
			FOVCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
			FOVCircle.Radius = Settings.SilentAimFOV
			FOVCircle.Color = Settings.SilentAimFOVColor
		end
	end)
end

function setFullBright(v)
	Lighting.Brightness = v and 3 or 1
	Lighting.FogEnd = v and 99999 or 1000
	Lighting.OutdoorAmbient = v and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(128, 128, 128)
	Lighting.GlobalShadows = not v
end
function setNoFog(v)
	Lighting.FogEnd = v and 99999 or 1000
end

local espActive = false
local espConnections = {}
local function clearESPFor(character)
	if not character then return end
	local hl = character:FindFirstChild("ESP_HL")
	if hl then hl:Destroy() end
	local head = character:FindFirstChild("Head")
	if head then
		local bb = head:FindFirstChild("ESP_BB")
		if bb then bb:Destroy() end
	end
end
local function espLoop()
	while espActive do
		pcall(function()
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= LocalPlayer and plr.Character then
					local head = plr.Character:FindFirstChild("Head")
					local hum = plr.Character:FindFirstChildOfClass("Humanoid")
					if not head or not hum or hum.Health <= 0 then
						clearESPFor(plr.Character)
						continue
					end
					local hl = plr.Character:FindFirstChild("ESP_HL")
					if not hl then
						hl = Instance.new("Highlight")
						hl.Name = "ESP_HL"
						hl.FillTransparency = 0.5
						hl.OutlineTransparency = 0
						hl.Parent = plr.Character
					end
					hl.Adornee = plr.Character
					hl.FillColor = Settings.ESPColor
					hl.OutlineColor = Settings.ESPColor
					local showInfo = Settings.ESPShowName or Settings.ESPShowHP or Settings.ESPShowDistance
					local bb = head:FindFirstChild("ESP_BB")
					if showInfo then
						if not bb then
							bb = Instance.new("BillboardGui")
							bb.Name = "ESP_BB"
							bb.Size = UDim2.new(0, 150, 0, 50)
							bb.StudsOffset = Vector3.new(0, 3, 0)
							bb.AlwaysOnTop = true
							bb.Parent = head
							local label = Instance.new("TextLabel")
							label.Name = "ESP_Text"
							label.Size = UDim2.new(1, 0, 1, 0)
							label.BackgroundTransparency = 1
							label.TextColor3 = Color3.fromRGB(255, 255, 255)
							label.TextSize = 12
							label.Font = Enum.Font.GothamBold
							label.TextStrokeTransparency = 0.5
							label.Parent = bb
						end
						local label = bb:FindFirstChild("ESP_Text")
						if label then
							local parts = {}
							if Settings.ESPShowName then table.insert(parts, plr.Name) end
							if Settings.ESPShowHP then
								table.insert(parts, math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) .. " HP")
							end
							if Settings.ESPShowDistance and LocalPlayer.Character then
								local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
								if root then
									table.insert(parts, math.floor((head.Position - root.Position).Magnitude) .. "m")
								end
							end
							label.Text = table.concat(parts, "\n")
						end
					elseif bb then
						bb:Destroy()
					end
				end
			end
		end)
		task.wait(0.2)
	end
end
function enableESP()
	espActive = true
	for _, conn in ipairs(espConnections) do pcall(function() conn:Disconnect() end) end
	espConnections = {}
	table.insert(espConnections, Players.PlayerRemoving:Connect(function(plr) clearESPFor(plr.Character) end))
	task.spawn(espLoop)
end
function disableESP()
	espActive = false
	for _, conn in ipairs(espConnections) do pcall(function() conn:Disconnect() end) end
	espConnections = {}
	for _, plr in ipairs(Players:GetPlayers()) do clearESPFor(plr.Character) end
end

local noRecoilActive = false
local noRecoilConnections = {}
function setNoRecoil(v)
	if not v then
		noRecoilActive = false
		for _, conn in ipairs(noRecoilConnections) do pcall(function() conn:Disconnect() end) end
		noRecoilConnections = {}
		return
	end
	noRecoilActive = true
	table.insert(noRecoilConnections, RunService.RenderStepped:Connect(function()
		if not noRecoilActive then return end
		local recoil = LocalPlayer:FindFirstChild("Recoil")
		if not recoil then return end
		for _, n in ipairs({"CurrentRecoil", "CurrentRecoil2"}) do
			local cr = recoil:FindFirstChild(n)
			if cr and cr:IsA("CFrameValue") then cr.Value = CFrame.new() end
		end
		local cr3 = recoil:FindFirstChild("CurrentRecoil3")
		if cr3 and cr3:IsA("NumberValue") then cr3.Value = 0 end
	end))
	table.insert(noRecoilConnections, RunService.Heartbeat:Connect(function()
		if not noRecoilActive then return end
		local char = LocalPlayer.Character
		if not char then return end
		local gav = char:FindFirstChild("GUNAIMVALUE")
		if gav then
			for _, c in ipairs(gav:GetChildren()) do
				if c:IsA("NumberValue") then c.Value = 0 end
			end
			if gav:IsA("NumberValue") then gav.Value = 0 end
		end
	end))
	local function clearAttachmentStats(tool)
		if not tool:IsA("Tool") then return end
		local folder = tool:FindFirstChild("AttachmentFolder")
		if not folder then return end
		for _, attachment in ipairs(folder:GetChildren()) do
			local isAttachment = attachment:FindFirstChild("IsAttachment")
			if isAttachment and isAttachment.Value == "Sights" then
				local stats = attachment:FindFirstChild("Stats")
				if stats then
					for _, name in ipairs({
						"GunRecoil", "GunRecoilX", "GunRecoilAimed", "RecoilAngle",
						"RecoilSpread", "RecoilStrength", "AimSway", "AimSpeed", "AimScatterMultiplyer"
					}) do
						local stat = stats:FindFirstChild(name)
						if stat and stat:IsA("NumberValue") then stat.Value = 0 end
					end
				end
			end
		end
	end
	table.insert(noRecoilConnections, RunService.Heartbeat:Connect(function()
		if not noRecoilActive then return end
		local bp = LocalPlayer:FindFirstChild("Backpack")
		if bp then for _, tool in ipairs(bp:GetChildren()) do clearAttachmentStats(tool) end end
		local char = LocalPlayer.Character
		if char then for _, tool in ipairs(char:GetChildren()) do clearAttachmentStats(tool) end end
	end))
	table.insert(noRecoilConnections, RunService.Heartbeat:Connect(function()
		if not noRecoilActive then return end
		local char = LocalPlayer.Character
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")
		if not humanoid then return end
		for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
			if not track.Animation then continue end
			local name = track.Animation.Name:lower()
			if name:find("fire") or name:find("recoil") or name:find("aim") then
				track:AdjustSpeed(999)
			end
		end
	end))
	table.insert(noRecoilConnections, RunService.Heartbeat:Connect(function()
		if not noRecoilActive then return end
		local char = LocalPlayer.Character
		if not char then return end
		for _, tool in ipairs(char:GetChildren()) do
			if not tool:IsA("Tool") then continue end
			for name, value in pairs({
				GunRecoil = 0, GunRecoilX = 0, RecoilAngle = 0,
				RecoilSpread = 0, RecoilStrength = 0, AimSway = 0
			}) do
				local existing = tool:FindFirstChild(name)
				if existing then existing.Value = value
				else
					local val = Instance.new("NumberValue")
					val.Name = name
					val.Value = value
					val.Parent = tool
				end
			end
		end
	end))
end

local swayActive = false
function setNoSway(v)
	if not v then swayActive = false return end
	swayActive = true
	task.spawn(function()
		while swayActive do
			local char = LocalPlayer.Character
			if char then
				local gav = char:FindFirstChild("GUNAIMVALUE") or char:FindFirstChild("GunAimValue")
				if gav then
					for _, c in ipairs(gav:GetChildren()) do
						if c:IsA("NumberValue") then c.Value = 0
						elseif c:IsA("BoolValue") and c.Name:lower():find("aim") then c.Value = false end
					end
				end
				for _, obj in ipairs(char:GetDescendants()) do
					if obj:IsA("NumberValue") and obj.Name:lower():find("sway") then obj.Value = 0 end
				end
			end
			task.wait()
		end
	end)
end

local triggerActive = false
local triggerConn
function enableTriggerBot()
	triggerActive = true
	triggerConn = RunService.RenderStepped:Connect(function()
		if not triggerActive then return end
		local cam = workspace.CurrentCamera
		if not cam or not LocalPlayer.Character then return end
		local ray = Ray.new(cam.CFrame.Position, cam.CFrame.LookVector * 1000)
		local hit = workspace:FindPartOnRay(ray, LocalPlayer.Character)
		if not hit then return end
		local hum = hit.Parent:FindFirstChildOfClass("Humanoid")
			or (hit.Parent.Parent and hit.Parent.Parent:FindFirstChildOfClass("Humanoid"))
		if hum and hum.Health > 0 and hum.Parent ~= LocalPlayer.Character then
			mouse1press()
			task.wait(0.05)
			mouse1release()
		end
	end)
end
function disableTriggerBot()
	triggerActive = false
	if triggerConn then triggerConn:Disconnect() triggerConn = nil end
end

local infAmmoActive = false
function enableInfiniteAmmo()
	infAmmoActive = true
	task.spawn(function()
		while infAmmoActive do
			local char = LocalPlayer.Character
			if char then
				for _, tool in ipairs(char:GetChildren()) do
					if tool:IsA("Tool") then
						local gs = tool:FindFirstChild("GunScript") or tool:FindFirstChild("Gun") or tool:FindFirstChild("WeaponScript")
						if gs then
							local ammo = gs:FindFirstChild("ClientAmmo") or gs:FindFirstChild("Ammo") or gs:FindFirstChild("CurrentAmmo")
							local maxAmmo = gs:FindFirstChild("MaxAmmo") or gs:FindFirstChild("Max") or gs:FindFirstChild("ClipSize")
							if ammo then ammo.Value = maxAmmo and maxAmmo.Value or 30 end
						end
					end
				end
			end
			task.wait(0.1)
		end
	end)
end
function disableInfiniteAmmo() infAmmoActive = false end

local instantReloadActive = false
function setInstantReload(v)
	if not v then instantReloadActive = false return end
	instantReloadActive = true
	task.spawn(function()
		while instantReloadActive do
			local char = LocalPlayer.Character
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
			if humanoid then
				for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
					local name = track.Animation and track.Animation.Name:lower() or ""
					if name:find("reload") or name:find("bolt") or name:find("cock") then
						track:AdjustSpeed(10)
					end
				end
			end
			task.wait(0.05)
		end
	end)
end

local noSpreadActive = false
local noSpreadConnections = {}
local function patchNoSpread(tool)
	if not tool:IsA("Tool") then return end
	local settingsModule = tool:FindFirstChild("Settings")
	if not settingsModule then return end
	local ok, config = pcall(require, settingsModule)
	if not ok or type(config) ~= "table" then return end
	if config.scatter ~= nil then config.scatter = 0.0001 end
end
local function patchAllNoSpread()
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if bp then for _, tool in ipairs(bp:GetChildren()) do patchNoSpread(tool) end end
	local char = LocalPlayer.Character
	if char then for _, tool in ipairs(char:GetChildren()) do patchNoSpread(tool) end end
end
function setNoSpread(v)
	if not v then
		noSpreadActive = false
		for _, conn in ipairs(noSpreadConnections) do pcall(function() conn:Disconnect() end) end
		noSpreadConnections = {}
		return
	end
	noSpreadActive = true
	patchAllNoSpread()
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if bp then
		table.insert(noSpreadConnections, bp.ChildAdded:Connect(function(tool)
			task.wait(0.05)
			if noSpreadActive then patchNoSpread(tool) end
		end))
	end
	table.insert(noSpreadConnections, LocalPlayer.CharacterAdded:Connect(function(char)
		table.insert(noSpreadConnections, char.ChildAdded:Connect(function(tool)
			task.wait(0.05)
			if noSpreadActive then patchNoSpread(tool) end
		end))
		task.wait(0.5)
		if noSpreadActive then patchAllNoSpread() end
	end))
	if LocalPlayer.Character then
		table.insert(noSpreadConnections, LocalPlayer.Character.ChildAdded:Connect(function(tool)
			task.wait(0.05)
			if noSpreadActive then patchNoSpread(tool) end
		end))
	end
end


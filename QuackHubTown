local function runAntiCheatBypass()
	task.wait(0.5)
	local detectedFunc
	for _, v in pairs(getgc(true)) do
		if type(v) == "table" then
			local ok, d = pcall(rawget, v, "Detected")
			if ok and type(d) == "function" then
				detectedFunc = d
				break
			end
		end
	end
	if detectedFunc then
		pcall(function()
			hookfunction(detectedFunc, function(...)
				coroutine.yield()
			end)
		end)
	end
	task.wait()
	local kills = {}
	for _, v in pairs(getgc(true)) do
		if type(v) == "table" then
			local ok, k = pcall(rawget, v, "Kill")
			if ok and type(k) == "function" then
				table.insert(kills, k)
			end
		end
	end
	for _, k in ipairs(kills) do
		pcall(function() hookfunction(k, function(...) end) end)
		task.wait()
	end
end


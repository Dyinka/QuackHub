-- farm
local function pryg(t)
	local h = koren()
	if not h or not t or not t.Parent then return false end
	h.AssemblyLinearVelocity = Vector3.zero
	h.AssemblyAngularVelocity = Vector3.zero
	h.CFrame = h.CFrame + Vector3.new(0, up, 0)
	task.wait(rw)
	if not h.Parent or not t.Parent then return false end
	h.AssemblyLinearVelocity = Vector3.zero
	h.AssemblyAngularVelocity = Vector3.zero
	h.CFrame = t.CFrame + Vector3.new(0, 3, 0)
	return true
end

local function nazhmi(p)
	if not p or not p.Parent then return end
	p.Enabled = true
	p.RequiresLineOfSight = false
	p.MaxActivationDistance = math.huge
	p.HoldDuration = 0
	if fireproximityprompt then
		pcall(fireproximityprompt, p)
	else
		p:InputHoldBegin()
		task.wait(0.05)
		p:InputHoldEnd()
	end
end

local function naydi()
	local l = {}
	local m = workspace:FindFirstChild("Map")
	if not m then return l end
	for _, f in ipairs(m:GetChildren()) do
		if not f.Name:match("^Floor") then continue end
		for _, d in ipairs(f:GetDescendants()) do
			if d.Name == "ItemSpawns" then
				for _, it in ipairs(d:GetChildren()) do
					if moneta(it) then
						local n = popytki[it] or 0
						if n >= popyt then continue end
						local p, pt
						for _, x in ipairs(it:GetDescendants()) do
							if x:IsA("ProximityPrompt") and x.Enabled then
								p = x
								pt = x.Parent:IsA("BasePart") and x.Parent
									or x.Parent:FindFirstChildWhichIsA("BasePart")
								break
							end
						end
						if not pt then
							pt = it.PrimaryPart or it:FindFirstChildWhichIsA("BasePart")
						end
						if pt then
							table.insert(l, { m = it, p = pt, pr = p })
						end
					end
				end
			end
		end
	end
	return l
end

local function vorota()
	local g = {}
	local m = workspace:FindFirstChild("Map")
	if not m then return g end
	for _, f in ipairs(m:GetChildren()) do
		if not f.Name:match("^Floor") then continue end
		for _, md in ipairs(f:GetChildren()) do
			if md:IsA("Model") and not gotovo[md] then
				local tr = md:FindFirstChild("Trigger")
				local en = md:FindFirstChild("End")
				if tr and en and tr:IsA("BasePart") and en:IsA("BasePart") then
					table.insert(g, { m = md, tr = tr, en = en })
				end
			end
		end
	end
	return g
end

local function dalwe()
	if os.clock() - lastskip < scd then return false end
	local h = koren()
	if not h then return false end
	local g = vorota()
	if #g == 0 then return false end
	local best, bd
	for _, gt in ipairs(g) do
		local d = (h.Position - gt.tr.Position).Magnitude
		if not bd or d < bd then best, bd = gt, d end
	end
	if not best then return false end
	gotovo[best.m] = true
	lastskip, lasta = os.clock(), os.clock()
	zan = true
	task.spawn(function()
		pryg(best.tr)
		task.wait(atw)
		local h2 = koren()
		if h2 and best.en and best.en.Parent then
			h2.AssemblyLinearVelocity = Vector3.zero
			h2.AssemblyAngularVelocity = Vector3.zero
			h2.CFrame = h2.CFrame + Vector3.new(0, up, 0)
			task.wait(rw)
			if h2.Parent and best.en.Parent then
				h2.AssemblyLinearVelocity = Vector3.zero
				h2.AssemblyAngularVelocity = Vector3.zero
				h2.CFrame = best.en.CFrame + Vector3.new(0, 3, 0)
			end
		end
		zan = false
	end)
	return true
end

function shag()
	if not huachu or zan then return end
	if os.clock() - lasta < cd then return end
	murka()
	local c = naydi()
	if #c > 0 then
		local h = koren()
		if not h then return end
		local best, bd
		for _, e in ipairs(c) do
			local d = (h.Position - e.p.Position).Magnitude
			if not bd or d < bd then best, bd = e, d end
		end
		if not best then return end
		popytki[best.m] = (popytki[best.m] or 0) + 1
		lasta = os.clock()
		zan = true
		task.spawn(function()
			pryg(best.p)
			task.wait(0.1)
			if best.pr then nazhmi(best.pr) end
			task.wait(0.15)
			if not best.m.Parent then
				popytki[best.m] = popyt
			end
			zan = false
			murka()
		end)
		return
	end
	dalwe()
end

local function ekran(o)
	if panel then panel.Visible = not o end
	if ov then ov.Visible = o end
	razmyt(o)
	if dconn then dconn:Disconnect() dconn = nil end
	if o and dbtn then
		local a = 0
		dconn = fr.RenderStepped:Connect(function(dt)
			a = (a + dt * 35) % 360
			dbtn.Rotation = math.sin(a * math.pi / 180) * 8
		end)
	elseif dbtn then
		dbtn.Rotation = 0
	end
end

local function vkli(o)
	huachu = o
	table.clear(gotovo)
	table.clear(popytki)
	zan = false
	if o then sc = babki() end
	murka()
	if conn then conn:Disconnect() conn = nil end
	if o then conn = fr.Heartbeat:Connect(shag) end
	ekran(o)
end


local function razmyt(o)
	if o then
		if not blur or not blur.Parent then
			blur = svet:FindFirstChild("QuackCoinBlur")
			if not blur then
				blur = Instance.new("BlurEffect")
				blur.Name = "QuackCoinBlur"
				blur.Parent = svet
			end
		end
		blur.Size = 0
		blur.Enabled = true
		tv:Create(blur, TweenInfo.new(0.35), { Size = 18 }):Play()
		if dim then
			dim.Visible = true
			dim.BackgroundTransparency = 1
			tv:Create(dim, TweenInfo.new(0.35), { BackgroundTransparency = 0.45 }):Play()
		end
	else
		if blur then
			local t = tv:Create(blur, TweenInfo.new(0.3), { Size = 0 })
			t:Play()
			t.Completed:Connect(function()
				if blur and not huachu then blur.Enabled = false end
			end)
		end
		if dim then
			local t = tv:Create(dim, TweenInfo.new(0.3), { BackgroundTransparency = 1 })
			t:Play()
			t.Completed:Connect(function()
				if dim and not huachu then dim.Visible = false end
			end)
		end
	end
end


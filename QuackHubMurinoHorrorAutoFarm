local function clickBtn(btn)
	if not btn then return end
	pcall(function()
		for _, c in ipairs(getconnections(btn.Activated)) do pcall(function() c:Fire() end) end
	end)
	pcall(function()
		for _, c in ipairs(getconnections(btn.MouseButton1Click)) do pcall(function() c:Fire() end) end
	end)
	pcall(function() if btn:IsA("GuiButton") then btn:Activate() end end)
end

local function forceSkipDeath()
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	local ds = pg and pg:FindFirstChild("DeathScreen")
	if not ds then return end
	local red = ds:FindFirstChild("Red")
	local skip = red and red:FindFirstChild("SkipButton")
	if skip then
		pcall(function() skip.Visible = true end)
		clickBtn(skip)
	end
end

local function isPlayAgainButton(btn)
	if not btn or not (btn:IsA("TextButton") or btn:IsA("ImageButton")) then return false end
	local n = string.lower(btn.Name or "")
	local t = string.lower(btn.Text or "")
	if n:find("leave") or n:find("revive") or t:find("leave") or t:find("revive") then
		return false
	end
	if n:find("play") or n:find("again") or n:find("retry")
		or t:find("play") or t:find("again") or t:find("играть")
		or t:find("заново") or t:find("снова") then
		return true
	end
	return false
end

local function tryPlayAgainButtons()
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	local ds = pg and pg:FindFirstChild("DeathScreen")
	if not ds then return false end
	local paf = ds:FindFirstChild("PlayAgainFrame")
	if not paf then return false end
	pcall(function() paf.Visible = true end)

	for _, d in ipairs(paf:GetDescendants()) do
		if isPlayAgainButton(d) then
			clickBtn(d)
			return true
		end
	end
	for _, d in ipairs(paf:GetDescendants()) do
		if d:IsA("TextButton") or d:IsA("ImageButton") then
			local n = string.lower(d.Name or "")
			if not n:find("leave") and not n:find("revive") then
				clickBtn(d)
				return true
			end
		end
	end
	for _, d in ipairs(ds:GetDescendants()) do
		if isPlayAgainButton(d) then
			clickBtn(d)
			return true
		end
	end
	return false
end

local function handleDeath()
	if deathHandling then return end
	deathHandling = true
	task.spawn(function()
		for _ = 1, 12 do
			forceSkipDeath()
			task.wait(0.12)
		end
		local tEnd = os.clock() + 25
		while os.clock() < tEnd do
			local pg = LocalPlayer:FindFirstChild("PlayerGui")
			local ds = pg and pg:FindFirstChild("DeathScreen")
			local paf = ds and ds:FindFirstChild("PlayAgainFrame")
			if paf and paf.Visible then
				tryPlayAgainButtons()
				task.wait(0.5)
				tryPlayAgainButtons()
				break
			end
			tryPlayAgainButtons()
			task.wait(0.4)
		end
		deathHandling = false
	end)
end


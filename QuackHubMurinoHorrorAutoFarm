local function mk(class, props)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	return o
end
local function corner(p, r)
	return mk("UICorner", { CornerRadius = UDim.new(0, r or 10), Parent = p })
end
local function stroke(p, col, th, tr)
	return mk("UIStroke", {
		Color = col or C.ButtonStroke,
		Thickness = th or 1,
		Transparency = tr or 0.35,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = p,
	})
end

local function getHRP()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function isCoinsModel(m)
	return m and m:IsA("Model") and m.Name:lower() == "coins"
end

local function getCoinsValue()

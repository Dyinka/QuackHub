--==============================================================
-- Farm core
--==============================================================
local function hopThenTp(targetPart)
	local hrp = getHRP()
	if not hrp or not targetPart or not targetPart.Parent then return false end
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	hrp.CFrame = hrp.CFrame + Vector3.new(0, UP_HEIGHT, 0)
	task.wait(ROOF_WAIT)
	if not hrp.Parent or not targetPart.Parent then return false end
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
	return true
end

local function firePrompt(prompt)
	if not prompt or not prompt.Parent then return end
	pcall(function()
		prompt.Enabled = true
		prompt.RequiresLineOfSight = false
		prompt.MaxActivationDistance = math.huge
		prompt.HoldDuration = 0
	end)
	if fireproximityprompt then
		pcall(fireproximityprompt, prompt)
	else
		pcall(function()
			prompt:InputHoldBegin()
			task.wait(0.05)
			prompt:InputHoldEnd()
		end)
	end
end

local function collectCoins()
	local list = {}
	local map = workspace:FindFirstChild("Map")
	if not map then return list end
	for _, floor in ipairs(map:GetChildren()) do
		if not floor.Name:match("^Floor") then continue end
		for _, desc in ipairs(floor:GetDescendants()) do
			if desc.Name == "ItemSpawns" then
				for _, item in ipairs(desc:GetChildren()) do
					if isCoinsModel(item) then
						local tries = coinTries[item] or 0
						if tries >= COIN_TRIES then continue end
						local prompt, part
						for _, d in ipairs(item:GetDescendants()) do
							if d:IsA("ProximityPrompt") and d.Enabled then
								prompt = d
								part = d.Parent:IsA("BasePart") and d.Parent
									or d.Parent:FindFirstChildWhichIsA("BasePart")
								break
							end
						end
						if not part then
							part = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
						end
						if part then
							table.insert(list, { model = item, part = part, prompt = prompt })
						end
					end
				end
			end
		end
	end
	return list
end

local function getRoomGates()
	local gates = {}
	local map = workspace:FindFirstChild("Map")
	if not map then return gates end
	for _, floor in ipairs(map:GetChildren()) do
		if not floor.Name:match("^Floor") then continue end
		for _, model in ipairs(floor:GetChildren()) do
			if model:IsA("Model") and not completedRooms[model] then
				local trig = model:FindFirstChild("Trigger")
				local en = model:FindFirstChild("End")
				if trig and en and trig:IsA("BasePart") and en:IsA("BasePart") then
					table.insert(gates, { model = model, trig = trig, en = en })
				end
			end
		end
	end
	return gates
end

local function tryNextRoom()
	if os.clock() - lastSkip < SKIP_COOLDOWN then return false end
	local hrp = getHRP()
	if not hrp then return false end
	local gates = getRoomGates()
	if #gates == 0 then return false end
	local best, bestDist
	for _, gate in ipairs(gates) do
		local d = (hrp.Position - gate.trig.Position).Magnitude
		if not bestDist or d < bestDist then best, bestDist = gate, d end
	end
	if not best then return false end
	completedRooms[best.model] = true
	lastSkip, lastAction = os.clock(), os.clock()
	busy = true
	task.spawn(function()
		hopThenTp(best.trig)
		task.wait(AFTER_TRIG_WAIT)
		local hrp2 = getHRP()
		if hrp2 and best.en and best.en.Parent then
			hrp2.AssemblyLinearVelocity = Vector3.zero
			hrp2.AssemblyAngularVelocity = Vector3.zero
			hrp2.CFrame = hrp2.CFrame + Vector3.new(0, UP_HEIGHT, 0)
			task.wait(ROOF_WAIT)
			if hrp2.Parent and best.en.Parent then
				hrp2.AssemblyLinearVelocity = Vector3.zero
				hrp2.AssemblyAngularVelocity = Vector3.zero
				hrp2.CFrame = best.en.CFrame + Vector3.new(0, 3, 0)
			end
		end
		busy = false
	end)
	return true
end

function farmTick()
	if not farmOn or busy then return end
	if os.clock() - lastAction < COOLDOWN then return end
	updateMur()
	local coins = collectCoins()
	if #coins > 0 then
		local hrp = getHRP()
		if not hrp then return end
		local best, bestDist
		for _, e in ipairs(coins) do
			local d = (hrp.Position - e.part.Position).Magnitude
			if not bestDist or d < bestDist then best, bestDist = e, d end
		end
		if not best then return end
		coinTries[best.model] = (coinTries[best.model] or 0) + 1
		lastAction = os.clock()
		busy = true
		task.spawn(function()
			hopThenTp(best.part)
			task.wait(0.1)
			if best.prompt then firePrompt(best.prompt) end
			task.wait(0.15)
			if not best.model.Parent then
				coinTries[best.model] = COIN_TRIES
			end
			busy = false
			updateMur()
		end)
		return
	end
	tryNextRoom()
end

local function showOverlay(on)
	if panel then panel.Visible = not on end
	if farmOverlay then farmOverlay.Visible = on end
	setBlur(on)
	if duckSpinConn then duckSpinConn:Disconnect() duckSpinConn = nil end
	if on and duckBtn then
		local a = 0
		duckSpinConn = RunService.RenderStepped:Connect(function(dt)
			a = (a + dt * 35) % 360
			duckBtn.Rotation = math.sin(a * math.pi / 180) * 8
		end)
	elseif duckBtn then
		duckBtn.Rotation = 0
	end
end

local function setFarm(on)
	farmOn = on
	table.clear(completedRooms)
	table.clear(coinTries)
	busy = false
	if on then startCoins = getCoinsValue() end
	updateMur()
	if loopConn then loopConn:Disconnect() loopConn = nil end
	if on then loopConn = RunService.Heartbeat:Connect(farmTick) end
	showOverlay(on)
end


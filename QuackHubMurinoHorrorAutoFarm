local function useHamamEmote()
	local folder = LocalPlayer:FindFirstChild("Emotes")
	local em = folder and folder:FindFirstChild(EMOTE_NAME)
	if not em then
		local src = ReplicatedStorage:FindFirstChild("Emotes")
		src = src and src:FindFirstChild(EMOTE_NAME)
		if src then
			if not folder then
				folder = Instance.new("Folder")
				folder.Name = "Emotes"
				folder.Parent = LocalPlayer
			end
			em = src:Clone()
			em.Parent = folder
		end
	end
	if not em then return end
	local anim = em:IsA("Animation") and em
		or em:FindFirstChildOfClass("Animation")
		or em:FindFirstChildWhichIsA("Animation", true)
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or not anim then return end
	pcall(function() char:SetAttribute("Emoting", true) end)
	pcall(function()
		local t = hum:LoadAnimation(anim)
		t.Priority = Enum.AnimationPriority.Action
		t:Play()
	end)
end
task.defer(function() task.wait(0.5) useHamamEmote() end)


local function processSkvorec(skvorec)
	if not skvorec or skvorec.Name ~= "Skvorec" then return end
	if skvorecPrompted[skvorec] then return end
	
	pcall(function() skvorec:Destroy() end)
	skvorecPrompted[skvorec] = true
end

local function removeShakeCheckHitbox()
	local hitboxes = workspace:FindFirstChild("Hitboxes")
	if not hitboxes then return end
	
	for _, desc in ipairs(hitboxes:GetDescendants()) do
		if desc.Name == "ShakeCheckHitbox" then
			pcall(function() desc:Destroy() end)
		end
	end
end

local function scanSkvorec()
	local hitboxes = workspace:FindFirstChild("Hitboxes")
	if not hitboxes then return end
	
	for _, descendant in ipairs(hitboxes:GetDescendants()) do
		if descendant.Name == "Skvorec" then
			processSkvorec(descendant)
		elseif descendant.Name == "ShakeCheckHitbox" then
			pcall(function() descendant:Destroy() end)
		end
	end
end

local function setAutoSkvorec(on)
	skvorecOn = on
	if skvorecFolderConn then skvorecFolderConn:Disconnect() skvorecFolderConn = nil end
	if skvorecChildConn then skvorecChildConn:Disconnect() skvorecChildConn = nil end
	
	if not on then
		table.clear(skvorecPrompted)
		return
	end
	
	scanSkvorec()
	removeShakeCheckHitbox()
	
	local hitboxes = workspace:FindFirstChild("Hitboxes")
	if hitboxes then
		skvorecChildConn = hitboxes.DescendantAdded:Connect(function(descendant)
			if not skvorecOn then return end
			if descendant.Name == "Skvorec" then
				task.defer(function() processSkvorec(descendant) end)
			elseif descendant.Name == "ShakeCheckHitbox" then
				task.defer(function() pcall(function() descendant:Destroy() end) end)
			end
		end)
	end
	
	skvorecFolderConn = workspace.ChildAdded:Connect(function(child)
		if skvorecOn and child.Name == "Hitboxes" then
			task.delay(0.1, function()
				scanSkvorec()
				removeShakeCheckHitbox()
			end)
		end
	end)
	
	task.spawn(function()
		while skvorecOn do
			task.wait(1)
			scanSkvorec()
			removeShakeCheckHitbox()
		end
	end)
end


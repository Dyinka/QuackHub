local function hlArt(p)
	if not p or not p:IsA("BasePart") then return end
	if rmTag[p] then
		if rmTag[p].hl then rmTag[p].hl.Enabled = true end
		return
	end
	local hl = makeOutline(p, ESP.RoomLine)
	if hl then
		rmTag[p] = { hl = hl }
	end
end

local function scanRms()
	local map = workspace:FindFirstChild("Map")
	if not map then return end
	for _, f in ipairs(map:GetChildren()) do
		if not f.Name:match("^Floor") then continue end
		for _, d in ipairs(f:GetDescendants()) do
			if d.Name == "ArturRoom" then
				local door = d:FindFirstChild("Door")
				local part = door and door:FindFirstChild("Part")
				if part then hlArt(part) end
			end
		end
	end
end

local function setEspRm(on)
	rmOn = on
	if rmCn then rmCn:Disconnect() rmCn = nil end
	if not on then clrRm() return end
	scanRms()
	local map = workspace:FindFirstChild("Map")
	if map then
		rmCn = map.DescendantAdded:Connect(function(i)
			if not rmOn then return end
			if i.Name == "ArturRoom" then
				task.defer(function()
					local door = i:FindFirstChild("Door")
					local part = door and door:FindFirstChild("Part")
					if part then hlArt(part) end
				end)
			elseif i.Name == "Part" and i:IsA("BasePart") then
				local door = i.Parent
				local rm = door and door.Parent
				if door and door.Name == "Door" and rm and rm.Name == "ArturRoom" then
					hlArt(i)
				end
			end
		end)
	end
	task.spawn(function()
		while rmOn do scanRms() task.wait(2.5) end
	end)
end

local function isCoin(m)
	if not m then return false end
	local n = m.Name:lower()
	for cn in pairs(coinN) do
		if n:find(cn) then return true end
	end
	return false
end

local function clrIHl()
	for m, entry in pairs(espTag) do
		destroyTag(entry)
	end
	table.clear(espTag)
end

local function hlItem(m)
	if not espOn then return end
	if not m or not m:IsA("Model") or not m.Parent then return end

	local coin = isCoin(m)
	local line = coin and ESP.CoinLine or ESP.ItemLine

	local entry = espTag[m]
	if entry and entry.hl and entry.hl.Parent then
		entry.hl.Enabled = true
		entry.hl.OutlineColor = line
		return
	end

	local hl = makeOutline(m, line)
	if hl then
		espTag[m] = { hl = hl, coin = coin }
	end
end

local function scanIS()
	local map = workspace:FindFirstChild("Map")
	if not map then return end
	for _, f in ipairs(map:GetChildren()) do
		if f.Name:match("^Floor") then
			for _, d in ipairs(f:GetDescendants()) do
				if d.Name == "ItemSpawns" then
					for _, it in ipairs(d:GetChildren()) do
						if it:IsA("Model") then hlItem(it) end
					end
				end
			end
		end
	end
end

local function bindIM(map)
	if espCn then espCn:Disconnect() espCn = nil end
	espCn = map.DescendantAdded:Connect(function(i)
		if not espOn then return end
		if i.Name == "ItemSpawns" then
			task.defer(function()
				for _, it in ipairs(i:GetChildren()) do
					if it:IsA("Model") then hlItem(it) end
				end
			end)
		elseif i:IsA("Model") and i.Parent and i.Parent.Name == "ItemSpawns" then
			task.defer(function() hlItem(i) end)
		end
	end)
end

local function startIL()
	if espRun then return end
	espRun = true
	task.spawn(function()
		while espOn do
			scanIS()
			for m, entry in pairs(espTag) do
				if not m.Parent then
					destroyTag(entry)
					espTag[m] = nil
				end
			end
			task.wait(2)
		end
		espRun = false
	end)
end

local function setEsp(on)
	espOn = on
	if espCn then espCn:Disconnect() espCn = nil end
	if espWc then espWc:Disconnect() espWc = nil end
	if not on then clrIHl() return end
	scanIS()
	local map = workspace:FindFirstChild("Map")
	if map then bindIM(map) end
	espWc = workspace.ChildAdded:Connect(function(c)
		if not espOn then return end
		if c.Name == "Map" then
			task.defer(function() bindIM(c) scanIS() end)
		end
	end)
	startIL()
end

local function rbCache()
	if not pkOn then return end
	local nc = {}
	local h = getHRP()
	if not h then pkCh = nc return end
	local map = workspace:FindFirstChild("Map")
	if not map then pkCh = nc return end
	for _, f in ipairs(map:GetChildren()) do
		if f.Name:match("^Floor") then
			for _, d in ipairs(f:GetDescendants()) do
				if d.Name == "ItemSpawns" then
					for _, it in ipairs(d:GetChildren()) do
						if it:IsA("Model") then
							local cn = isCoin(it)
							for _, c in ipairs(it:GetDescendants()) do
								if c:IsA("ProximityPrompt") and c.Enabled then
									local p = c.Parent:IsA("BasePart") and c.Parent or c.Parent:FindFirstChildWhichIsA("BasePart")
									if p then
										table.insert(nc, {
											prompt = c, part = p,
											distance = (h.Position - p.Position).Magnitude,
											isCoin = cn,
										})
									end
								end
							end
						end
					end
				end
			end
		end
	end
	pkCh = nc
end

local function findBest()
	local h = getHRP()
	if not h or #pkCh == 0 then return nil end
	local bc, bcd = nil, math.huge
	local bo, bod = nil, math.huge
	for _, e in ipairs(pkCh) do
		if not e.prompt.Enabled then continue end
		if pkCd[e.prompt] then continue end
		local d = (h.Position - e.part.Position).Magnitude
		local md = e.prompt.MaxActivationDistance > 0 and e.prompt.MaxActivationDistance or 10
		if d <= md + 2 then
			if e.isCoin and d < bcd then bc, bcd = e, d
			elseif not e.isCoin and d < bod then bo, bod = e, d end
		end
	end
	return bc or bo
end

local function fireP(p)
	if not p or not p.Parent then return end
	pcall(function()
		p.Enabled = true
		p.RequiresLineOfSight = false
		p.MaxActivationDistance = math.huge
		p.HoldDuration = 0
	end)
	if fireproximityprompt then pcall(fireproximityprompt, p)
	else pcall(function() p:InputHoldBegin() task.wait(0.05) p:InputHoldEnd() end) end
	pkCd[p] = true
	task.delay(1.5, function() pkCd[p] = nil end)
end

local function pkTick()
	if not pkOn then return end
	local b = findBest()
	if b then fireP(b.prompt) end
end

local function setPk(on)
	pkOn = on
	if pkSc then pkSc:Disconnect() pkSc = nil end
	if pkHc then pkHc:Disconnect() pkHc = nil end
	if not on then pkCh = {} table.clear(pkCd) return end
	rbCache()
	pkHc = rs.Heartbeat:Connect(pkTick)
	local ls = 0
	pkSc = rs.Heartbeat:Connect(function()
		if not pkOn then return end
		local n = os.clock()
		if n - ls >= 0.7 then ls = n rbCache() end
	end)
end

local function findMeats()
	local ms, seen = {}, {}
	local ok, tg = pcall(function() return cns:GetTagged("MeatsMonster") end)
	if ok and tg then
		for _, m in ipairs(tg) do
			if m:IsDescendantOf(workspace) and not seen[m] then seen[m] = true table.insert(ms, m) end
		end
	end
	local map = workspace:FindFirstChild("Map")
	if map then
		for _, f in ipairs(map:GetChildren()) do
			if f.Name:match("^Floor") then
				local mt = f:FindFirstChild("Meat")
				local mts = mt and mt:FindFirstChild("meats")
				if mts then
					for _, c in ipairs(mts:GetChildren()) do
						if not seen[c] then seen[c] = true table.insert(ms, c) end
					end
				end
			end
		end
	end
	local wm = workspace:FindFirstChild("meats")
	if wm then
		for _, c in ipairs(wm:GetChildren()) do
			if not seen[c] then seen[c] = true table.insert(ms, c) end
		end
	end
	return ms
end

local function hookMr()
	if mrHk or not hookfunction then return end
	mrOr = hookfunction(workspace.Raycast, function(self, orig, dir, params)
		if not fzOn then return mrOr(self, orig, dir, params) end
		local real = mrOr(self, orig, dir, params)
		for _, meat in ipairs(findMeats()) do
			if meat and meat.Parent then
				for _, d in ipairs(meat:GetDescendants()) do
					if d:IsA("BasePart") and d.Transparency < 1 then
						local tm = d.Position - orig
						if tm.Magnitude < 0.1 then return mrOr(self, orig, dir, params) end
						local du = dir.Unit
						if du:Dot(tm.Unit) > 0.85 and tm.Magnitude < dir.Magnitude + 5 then
							return {
								Instance = d, Position = d.Position, Distance = tm.Magnitude,
								Material = Enum.Material.Plastic, Normal = -du,
							}
						end
						break
					end
				end
			end
		end
		return real
	end)
	mrHk = true
end

local function setFz(on)
	fzOn = on
	if fzCn then fzCn:Disconnect() fzCn = nil end
	if not on then return end
	hookMr()
	if not oldMn and hookmetamethod then
		oldMn = hookmetamethod(game, "__namecall", function(self, ...)
			local m = getnamecallmethod()
			local a = {...}
			if m == "FireServer" and self == mtEv then
				if a[2] == false then return nil end
			end
			return oldMn(self, ...)
		end)
	end
	fzCn = rs.Heartbeat:Connect(function()
		if not fzOn then return end
		for _, meat in ipairs(findMeats()) do
			if meat and meat.Parent then pcall(function() mtEv:FireServer(meat, true) end) end
		end
	end)
end


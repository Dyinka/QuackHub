local function isSkip(m)
	return m and skipN[m.Name:lower()] == true
end

local function getSkips()
	local ms, seen = {}, {}
	local map = workspace:FindFirstChild("Map")
	if map then
		for _, f in ipairs(map:GetChildren()) do
			if f.Name:match("^Floor") then
				for _, ch in ipairs(f:GetChildren()) do
					if isSkip(ch) and not seen[ch] then
						seen[ch] = true
						table.insert(ms, ch)
					end
				end
			end
		end
	end
	for _, ch in ipairs(workspace:GetChildren()) do
		if isSkip(ch) and not seen[ch] then
			seen[ch] = true
			table.insert(ms, ch)
		end
	end
	return ms
end

local function tpTo(endP, model)
	local h = getHRP()
	if not h or not endP or not endP.Parent then return end
	if (h.Position - endP.Position).Magnitude < 8 then return end
	lastSk = os.clock()
	h.AssemblyLinearVelocity = Vector3.zero
	h.AssemblyAngularVelocity = Vector3.zero
	h.CFrame = h.CFrame + Vector3.new(0, 50, 0)
	task.delay(0.1, function()
		if not h or not h.Parent then return end
		h.AssemblyLinearVelocity = Vector3.zero
		h.AssemblyAngularVelocity = Vector3.zero
		h.CFrame = endP.CFrame + Vector3.new(0, 3, 0)
	end)
end

local function schedSk(model, endP)
	if pnSk[model] then return end
	if os.clock() - lastSk < skipCd then return end
	pnSk[model] = endP
	task.delay(skipDl, function()
		if pnSk[model] ~= endP then return end
		if not skipOn then pnSk[model] = nil return end
		pnSk[model] = nil
		if endP and endP.Parent then tpTo(endP, model) end
	end)
end

local function trySk(trg)
	if not skipOn then return end
	local model = trg.Parent
	if not isSkip(model) then return end
	local endP = model:FindFirstChild("End")
	if not endP or not endP:IsA("BasePart") then return end
	local h = getHRP()
	if not h then return end
	if (h.Position - endP.Position).Magnitude < 8 then return end
	schedSk(model, endP)
end

local function hookTrg(trg, model)
	if hkTrg[trg] then return end
	if not trg:IsA("BasePart") or not isSkip(model) then return end
	hkTrg[trg] = true
	trg.CanTouch = true
	trg.Touched:Connect(function(hit)
		if not skipOn then return end
		local c = lp.Character
		if not c or not hit:IsDescendantOf(c) then return end
		trySk(trg)
	end)
end

local function scanSk()
	for _, m in ipairs(getSkips()) do
		local tr = m:FindFirstChild("Trigger")
		local en = m:FindFirstChild("End")
		if tr and en then hookTrg(tr, m) end
	end
end

local function proxSk()
	if not skipOn then return end
	local h = getHRP()
	if not h then return end
	if os.clock() - lastSk < skipCd then return end
	for _, m in ipairs(getSkips()) do
		if pnSk[m] then continue end
		local tr = m:FindFirstChild("Trigger")
		local en = m:FindFirstChild("End")
		if not tr or not en then continue end
		if not tr:IsA("BasePart") or not en:IsA("BasePart") then continue end
		local r = math.max(tr.Size.Magnitude * 0.55, 6)
		if (h.Position - tr.Position).Magnitude <= r then
			if (h.Position - en.Position).Magnitude < 8 then continue end
			schedSk(m, en)
			return
		end
	end
end

local function setSk(on)
	skipOn = on
	if skipCn then skipCn:Disconnect() skipCn = nil end
	table.clear(pnSk)
	if not on then return end
	scanSk()
	workspace.DescendantAdded:Connect(function(i)
		if not skipOn then return end
		if i.Name == "Trigger" and i:IsA("BasePart") then
			local m = i.Parent
			if isSkip(m) and m:FindFirstChild("End") then hookTrg(i, m) end
		end
	end)
	skipCn = rs.Heartbeat:Connect(proxSk)
end

local artScEv = ev:FindFirstChild("ArturSpawn")
local function fireArtPr(pr)
	if not pr or not pr.Parent then return false end
	if artPr[pr] then return false end
	pcall(function()
		pr.Enabled = true
		pr.RequiresLineOfSight = false
		pr.MaxActivationDistance = math.huge
		pr.HoldDuration = 0
	end)
	local ti = pr:FindFirstChild("TouchInterest")
	if ti then for _ = 1, 5 do pcall(function() ti:Fire() end) end end
	if fireproximityprompt then
		local ok = pcall(fireproximityprompt, pr)
		if ok then artPr[pr] = true return true end
	end
	local ok = pcall(function()
		pr:InputHoldBegin()
		task.wait(0.1)
		pr:InputHoldEnd()
	end)
	if ok then artPr[pr] = true return true end
	return false
end

local function doArtHl(hl)
	if not hl or hl.Name ~= "ArturHighlight" then return end
	local a = hl.Adornee
	if not a or not a.Parent then return end
	if artPr[a] then return end
	local h = a:FindFirstChild("HumanoidRootPart")
	if not h then return end
	local pr = h:FindFirstChildOfClass("ProximityPrompt")
	if not pr then return end
	if fireArtPr(pr) then
		artPr[a] = true
		task.delay(0.1, function()
			if a.Parent then pcall(function() a:Destroy() end) end
		end)
	end
end

local function growMobs()
	local hb = workspace:FindFirstChild("Hitboxes")
	if not hb then return end
	for _, d in ipairs(hb:GetDescendants()) do
		if d.Name == "ArturCheckMobs" and d:IsA("BasePart") then
			d.Size = Vector3.new(2048, 2048, 2048)
			d.CanCollide = false
			d.CanTouch = true
			d.CanQuery = true
			d.Transparency = 1
		end
	end
end

local function scanArtHl()
	for _, d in ipairs(workspace:GetDescendants()) do
		if d.Name == "ArturHighlight" then doArtHl(d) end
	end
	growMobs()
end

local function setArt(on)
	artOn = on
	if artFc then artFc:Disconnect() artFc = nil end
	if artCc then artCc:Disconnect() artCc = nil end
	if artSc then artSc:Disconnect() artSc = nil end
	if not on then table.clear(artPr) return end
	scanArtHl()
	artCc = workspace.DescendantAdded:Connect(function(d)
		if not artOn then return end
		if d.Name == "ArturHighlight" then
			task.defer(function() doArtHl(d) end)
		elseif d.Name == "ArturCheckMobs" and d:IsA("BasePart") then
			d.Size = Vector3.new(2048, 2048, 2048)
			d.CanCollide = false
			d.CanTouch = true
			d.CanQuery = true
			d.Transparency = 1
		end
	end)
	if artScEv then
		artSc = artScEv.OnClientEvent:Connect(function(a1, a2)
			if not artOn then return end
			if a2 == "Start" then
				task.delay(0.1, function()
					if not artOn then return end
					if a1 and a1.Parent then
						local hl = a1:FindFirstChild("ArturHighlight")
						if hl then doArtHl(hl) end
					end
				end)
			end
		end)
	end
	task.spawn(function()
		while artOn do task.wait(1) scanArtHl() end
	end)
end


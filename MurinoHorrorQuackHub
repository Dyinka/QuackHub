--==============================================================
-- AUTO SKIP (Universal 2-stage teleport)
--==============================================================
local function getHRP()
	local char = LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function isSkipModel(model)
	return model and SKIP_NAMES[model.Name:lower()] == true
end

local function getAllSkipModels()
	local models = {}
	local seen = {}
	
	local map = workspace:FindFirstChild("Map")
	if map then
		for _, floor in ipairs(map:GetChildren()) do
			if floor.Name:match("^Floor") then
				for _, child in ipairs(floor:GetChildren()) do
					if isSkipModel(child) and not seen[child] then
						seen[child] = true
						table.insert(models, child)
					end
				end
			end
		end
	end
	
	for _, child in ipairs(workspace:GetChildren()) do
		if isSkipModel(child) and not seen[child] then
			seen[child] = true
			table.insert(models, child)
		end
	end
	
	return models
end

local function doTeleport(endPart, model)
	local hrp = getHRP()
	if not hrp or not endPart or not endPart.Parent then return end
	if (hrp.Position - endPart.Position).Magnitude < 8 then return end
	lastSkip = os.clock()
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	
	hrp.CFrame = hrp.CFrame + Vector3.new(0, 50, 0)
	
	task.delay(0.1, function()
		if not hrp or not hrp.Parent then return end
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.CFrame = endPart.CFrame + Vector3.new(0, 3, 0)
	end)
end

local function scheduleSkip(model, endPart)
	if pendingSkip[model] then return end
	if os.clock() - lastSkip < skipCooldown then return end
	pendingSkip[model] = endPart
	task.delay(skipDelay, function()
		if pendingSkip[model] ~= endPart then return end
		if not skipOn then
			pendingSkip[model] = nil
			return
		end
		pendingSkip[model] = nil
		if endPart and endPart.Parent then
			doTeleport(endPart, model)
		end
	end)
end

local function trySkip(triggerPart)
	if not skipOn then return end
	local model = triggerPart.Parent
	if not isSkipModel(model) then return end
	local endPart = model:FindFirstChild("End")
	if not endPart or not endPart:IsA("BasePart") then return end
	local hrp = getHRP()
	if not hrp then return end
	if (hrp.Position - endPart.Position).Magnitude < 8 then return end
	scheduleSkip(model, endPart)
end

local function hookTrigger(triggerPart, model)
	if hookedTriggers[triggerPart] then return end
	if not triggerPart:IsA("BasePart") or not isSkipModel(model) then return end
	hookedTriggers[triggerPart] = true
	pcall(function() triggerPart.CanTouch = true end)
	triggerPart.Touched:Connect(function(hit)
		if not skipOn then return end
		local char = LocalPlayer.Character
		if not char or not hit:IsDescendantOf(char) then return end
		trySkip(triggerPart)
	end)
end

local function scanSkipModels()
	for _, model in ipairs(getAllSkipModels()) do
		local trig = model:FindFirstChild("Trigger")
		local en = model:FindFirstChild("End")
		if trig and en then hookTrigger(trig, model) end
	end
end

local function proximitySkip()
	if not skipOn then return end
	local hrp = getHRP()
	if not hrp then return end
	if os.clock() - lastSkip < skipCooldown then return end
	
	for _, model in ipairs(getAllSkipModels()) do
		if pendingSkip[model] then continue end
		local trig = model:FindFirstChild("Trigger")
		local en = model:FindFirstChild("End")
		if not trig or not en then continue end
		if not trig:IsA("BasePart") or not en:IsA("BasePart") then continue end
		local radius = math.max(trig.Size.Magnitude * 0.55, 6)
		if (hrp.Position - trig.Position).Magnitude <= radius then
			if (hrp.Position - en.Position).Magnitude < 8 then continue end
			scheduleSkip(model, en)
			return
		end
	end
end

local function setAutoSkip(on)
	skipOn = on
	if skipConn then skipConn:Disconnect() skipConn = nil end
	table.clear(pendingSkip)
	if not on then return end
	scanSkipModels()
	
	workspace.DescendantAdded:Connect(function(inst)
		if not skipOn then return end
		if inst.Name == "Trigger" and inst:IsA("BasePart") then
			local model = inst.Parent
			if isSkipModel(model) and model:FindFirstChild("End") then
				hookTrigger(inst, model)
			end
		end
	end)
	
	skipConn = RunService.Heartbeat:Connect(proximitySkip)
end


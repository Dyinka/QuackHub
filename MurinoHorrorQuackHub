local function fireSel(gui, n)
	local s = gui:FindFirstChild("Selected")
	if s and s:IsA("BindableEvent") then s:Fire(n) return true end
	return false
end

local function onFood(gui, s)
	if not golOn or not s:IsA("Sound") then return end
	if not food[s.Name] then return end
	golId += 1
	local my = golId
	task.delay(0.25, function()
		if not golOn or my ~= golId then return end
		if not gui.Parent or not gui.Enabled then return end
		fireSel(gui, s.Name)
		task.delay(0.4, function()
			if not golOn or my ~= golId then return end
			if s.Parent and s.IsPlaying then fireSel(gui, s.Name) end
		end)
	end)
end

local function bindGol(gui)
	if golCc then golCc:Disconnect() golCc = nil end
	golCc = gui.ChildAdded:Connect(function(c)
		if not golOn then return end
		if c:IsA("Sound") and food[c.Name] then
			if c.IsPlaying then onFood(gui, c)
			else c.Played:Connect(function() onFood(gui, c) end) end
		end
	end)
	for _, c in ipairs(gui:GetChildren()) do
		if c:IsA("Sound") and food[c.Name] and c.IsPlaying then onFood(gui, c) end
	end
end

local function setGol(on)
	golOn = on
	golId = 0
	if golCn then golCn:Disconnect() golCn = nil end
	if golCc then golCc:Disconnect() golCc = nil end
	if not on then return end
	local g = getAmG()
	if g then bindGol(g) end
	lp:WaitForChild("PlayerGui").ChildAdded:Connect(function(c)
		if golOn and c.Name == "amamam" then task.wait(0.1) bindGol(c) end
	end)
	local ae = ev:FindFirstChild("amamam")
	if ae then
		golCn = ae.OnClientEvent:Connect(function()
			if not golOn then return end
			task.delay(0.5, function()
				local g2 = getAmG()
				if g2 then bindGol(g2) end
			end)
		end)
	end
end


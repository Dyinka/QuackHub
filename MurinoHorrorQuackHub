local function setWalkSpeed(on, speed)
	if speed then wsValue = speed end
	wsEnabled = on
	if wsConn then wsConn:Disconnect() wsConn = nil end

	if not on then
		local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = 16 end
		return
	end

	wsConn = RunService.Heartbeat:Connect(function()
		if not wsEnabled then return end
		local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if hum and hum.WalkSpeed ~= wsValue then
			hum.WalkSpeed = wsValue
		end
	end)

	local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if hum then hum.WalkSpeed = wsValue end
end

LocalPlayer.CharacterAdded:Connect(function(char)
	task.wait(0.3)
	if wsEnabled then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = wsValue end
	end
end)


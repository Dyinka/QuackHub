local function ensureNamecallHook()
	if oldNamecall then return end
	oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
		local method = getnamecallmethod()
		local args = { ... }
		if zaecOn then
			if method == "FireServer" and typeof(self) == "Instance" and self.Name == "Death" and args[1] == "Zaec" then
				return nil
			end
			if method == "InvokeServer" and typeof(self) == "Instance" and self.Name == "Dodging" then
				return true
			end
		end
		return oldNamecall(self, ...)
	end)
end

local function muteZaecClient()
	pcall(function()
		local zaec = Events:FindFirstChild("Zaec")
		if zaec and getconnections then
			for _, c in ipairs(getconnections(zaec.OnClientEvent)) do
				pcall(function() c:Disable() end)
			end
		end
	end)
	pcall(function()
		local pg = LocalPlayer:FindFirstChild("PlayerGui")
		local dm = pg and pg:FindFirstChild("DontMove")
		local img = dm and dm:FindFirstChild("ImageLabel")
		if img then img.Visible = false end
	end)
end

local function setDestroyZaec(on)
	zaecOn = on
	if on then
		ensureNamecallHook()
		muteZaecClient()
	end
end


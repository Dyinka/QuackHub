local function patchHealingGui(gui)
	if not gui or not instantUseOn then return end
	local amount = gui:FindFirstChild("Amount")
	if amount and (amount:IsA("NumberValue") or amount:IsA("IntValue")) then
		amount.Value = 0
	end
	local frame = gui:FindFirstChild("Frame")
	local bar = frame and frame:FindFirstChild("Frame")
	if bar and bar:IsA("GuiObject") then
		bar.Size = UDim2.new(1, 0, 1, 0)
	end
end

local function watchTool(tool)
	if not tool or not tool:IsA("Tool") then return end
	local name = tool.Name:lower()
	if not (name:find("bandag") or name:find("бинт") or tool:FindFirstChild("BandageScript")) then
		return
	end

	local function scan(parent)
		for _, d in ipairs(parent:GetDescendants()) do
			if d.Name == "HealingGui" or d.Name == "Amount" then
				if d.Name == "HealingGui" then
					patchHealingGui(d)
					d:GetPropertyChangedSignal("Enabled"):Connect(function()
						if d.Enabled then patchHealingGui(d) end
					end)
				elseif d:IsA("NumberValue") or d:IsA("IntValue") then
					if instantUseOn then d.Value = 0 end
					d:GetPropertyChangedSignal("Value"):Connect(function()
						if instantUseOn and d.Value > 0 then d.Value = 0 end
					end)
				end
			end
		end
	end

	scan(tool)
	table.insert(instantConns, tool.DescendantAdded:Connect(function(inst)
		if not instantUseOn then return end
		if inst.Name == "HealingGui" then
			patchHealingGui(inst)
		elseif inst.Name == "Amount" and (inst:IsA("NumberValue") or inst:IsA("IntValue")) then
			inst.Value = 0
		end
	end))
end

local function setInstantUse(on)
	instantUseOn = on
	for _, c in ipairs(instantConns) do pcall(function() c:Disconnect() end) end
	table.clear(instantConns)

	if not oldTweenCreate and hookfunction then
		pcall(function()
			oldTweenCreate = hookfunction(TweenService.Create, function(self, instance, info, props)
				if instantUseOn and info and typeof(info) == "TweenInfo" and info.Time and info.Time > 0.05 then
					local ok, inHeal = pcall(function()
						return instance and instance:IsA("GuiObject")
							and instance:FindFirstAncestor("HealingGui") ~= nil
					end)
					if ok and inHeal then
						info = TweenInfo.new(0, info.EasingStyle, info.EasingDirection)
					end
				end
				return oldTweenCreate(self, instance, info, props)
			end)
		end)
	end

	if not on then return end

	local function scanContainer(container)
		if not container then return end
		for _, t in ipairs(container:GetChildren()) do
			watchTool(t)
		end
		table.insert(instantConns, container.ChildAdded:Connect(function(ch)
			if instantUseOn then watchTool(ch) end
		end))
	end

	scanContainer(LocalPlayer:FindFirstChild("Backpack"))
	scanContainer(LocalPlayer.Character)
	table.insert(instantConns, LocalPlayer.CharacterAdded:Connect(function(char)
		task.wait(0.2)
		if instantUseOn then scanContainer(char) end
	end))
end


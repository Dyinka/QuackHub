-- AUTO ARTUR
--==============================================================
local arturSpawnEvent = Events:FindFirstChild("ArturSpawn")

local function triggerArturPromptStrict(prompt)
	if not prompt or not prompt.Parent then return false end
	if arturPrompted[prompt] then return false end

	pcall(function()
		prompt.Enabled = true
		prompt.RequiresLineOfSight = false
		prompt.MaxActivationDistance = math.huge
		prompt.HoldDuration = 0
	end)

	local touchInterest = prompt:FindFirstChild("TouchInterest")
	if touchInterest then
		for i = 1, 5 do
			pcall(function() touchInterest:Fire() end)
		end
	end

	if fireproximityprompt then
		local ok = pcall(fireproximityprompt, prompt)
		if ok then
			arturPrompted[prompt] = true
			return true
		end
	end

	local ok = pcall(function()
		prompt:InputHoldBegin()
		task.wait(0.1)
		prompt:InputHoldEnd()
	end)
	
	if ok then
		arturPrompted[prompt] = true
		return true
	end

	return false
end

local function processArturByHighlight(highlight)
	if not highlight or highlight.Name ~= "ArturHighlight" then return end
	
	local artur = highlight.Adornee
	if not artur or not artur.Parent then return end
	if arturPrompted[artur] then return end
	
	local hrp = artur:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	
	local prompt = hrp:FindFirstChildOfClass("ProximityPrompt")
	if not prompt then return end

	if triggerArturPromptStrict(prompt) then
		arturPrompted[artur] = true
		task.delay(0.1, function()
			if artur.Parent then pcall(function() artur:Destroy() end) end
		end)
	end
end

local function expandCheckMobs()
	local hitboxes = workspace:FindFirstChild("Hitboxes")
	if not hitboxes then return end

	for _, desc in ipairs(hitboxes:GetDescendants()) do
		if desc.Name == "ArturCheckMobs" and desc:IsA("BasePart") then
			pcall(function()
				desc.Size = Vector3.new(2048, 2048, 2048)
				desc.CanCollide = false
				desc.CanTouch = true
				desc.CanQuery = true
				desc.Transparency = 1
			end)
		end
	end
end

local function scanAllArturHighlights()
	for _, desc in ipairs(workspace:GetDescendants()) do
		if desc.Name == "ArturHighlight" then
			processArturByHighlight(desc)
		end
	end
	expandCheckMobs()
end

local function setAutoArtur(on)
	arturOn = on
	if arturFolderConn then arturFolderConn:Disconnect() arturFolderConn = nil end
	if arturChildConn then arturChildConn:Disconnect() arturChildConn = nil end
	if arturSpawnConn then arturSpawnConn:Disconnect() arturSpawnConn = nil end
	
	if not on then 
		table.clear(arturPrompted)
		return 
	end

	scanAllArturHighlights()
	
	arturChildConn = workspace.DescendantAdded:Connect(function(descendant)
		if not arturOn then return end
		
		if descendant.Name == "ArturHighlight" then
			task.defer(function() processArturByHighlight(descendant) end)
		elseif descendant.Name == "ArturCheckMobs" and descendant:IsA("BasePart") then
			pcall(function()
				descendant.Size = Vector3.new(2048, 2048, 2048)
				descendant.CanCollide = false
				descendant.CanTouch = true
				descendant.CanQuery = true
				descendant.Transparency = 1
			end)
		end
	end)
	
	if arturSpawnEvent then
		arturSpawnConn = arturSpawnEvent.OnClientEvent:Connect(function(a1, a2)
			if not arturOn then return end
			if a2 == "Start" then
				task.delay(0.1, function()
					if not arturOn then return end
					if a1 and a1.Parent then
						local hl = a1:FindFirstChild("ArturHighlight")
						if hl then
							processArturByHighlight(hl)
						end
					end
				end)
			end
		end)
	end
	
	task.spawn(function()
		while arturOn do
			task.wait(1)
			scanAllArturHighlights()
		end
	end)
end


--==============================================================
local function getAmamamGui()
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	return pg and pg:FindFirstChild("amamam")
end

local function fireSelected(gui, name)
	local selected = gui:FindFirstChild("Selected")
	if selected and selected:IsA("BindableEvent") then
		selected:Fire(name)
		return true
	end
	return false
end

local function onFoodSound(gui, sound)
	if not golodOn or not sound:IsA("Sound") then return end
	if not FOOD[sound.Name] then return end
	golodRoundId += 1
	local myRound = golodRoundId
	task.delay(0.25, function()
		if not golodOn or myRound ~= golodRoundId then return end
		if not gui.Parent or not gui.Enabled then return end
		fireSelected(gui, sound.Name)
		task.delay(0.4, function()
			if not golodOn or myRound ~= golodRoundId then return end
			if sound.Parent and sound.IsPlaying then fireSelected(gui, sound.Name) end
		end)
	end)
end

local function bindGolodGui(gui)
	if golodChildConn then golodChildConn:Disconnect() golodChildConn = nil end
	golodChildConn = gui.ChildAdded:Connect(function(child)
		if not golodOn then return end
		if child:IsA("Sound") and FOOD[child.Name] then
			if child.IsPlaying then onFoodSound(gui, child)
			else child.Played:Connect(function() onFoodSound(gui, child) end) end
		end
	end)
	for _, child in ipairs(gui:GetChildren()) do
		if child:IsA("Sound") and FOOD[child.Name] and child.IsPlaying then
			onFoodSound(gui, child)
		end
	end
end

local function setAutoGolod(on)
	golodOn = on
	golodRoundId = 0
	if golodConn then golodConn:Disconnect() golodConn = nil end
	if golodChildConn then golodChildConn:Disconnect() golodChildConn = nil end
	if not on then return end
	local gui = getAmamamGui()
	if gui then bindGolodGui(gui) end
	LocalPlayer:WaitForChild("PlayerGui").ChildAdded:Connect(function(child)
		if golodOn and child.Name == "amamam" then
			task.wait(0.1)
			bindGolodGui(child)
		end
	end)
	local amamamEv = Events:FindFirstChild("amamam")
	if amamamEv then
		golodConn = amamamEv.OnClientEvent:Connect(function()
			if not golodOn then return end
			task.delay(0.5, function()
				local g = getAmamamGui()
				if g then bindGolodGui(g) end
			end)
		end)
	end
end

--==============================================================
-- ESP ROOM 0000
--==============================================================
local function clearRoom0000()
	for part, hl in pairs(room0000Highlights) do
		pcall(function() hl:Destroy() end)
	end
	table.clear(room0000Highlights)
end

local function highlightArturPart(part)
	if not part or not part:IsA("BasePart") then return end
	if room0000Highlights[part] then
		room0000Highlights[part].Enabled = true
		return
	end
	local hl = Instance.new("Highlight")
	hl.Name = "QuackArturRoomHL"
	hl.Adornee = part
	hl.FillColor = Color3.fromRGB(0, 255, 200)
	hl.OutlineColor = Color3.fromRGB(255, 0, 180)
	hl.FillTransparency = 0.55
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = part
	room0000Highlights[part] = hl
end

local function scanArturRooms()
	local map = workspace:FindFirstChild("Map")
	if not map then return end
	for _, floor in ipairs(map:GetChildren()) do
		if not floor.Name:match("^Floor") then continue end
		for _, desc in ipairs(floor:GetDescendants()) do
			if desc.Name == "ArturRoom" then
				local door = desc:FindFirstChild("Door")
				local part = door and door:FindFirstChild("Part")
				if part then highlightArturPart(part) end
			end
		end
	end
end

local function setEspRoom0000(on)
	room0000On = on
	if room0000Conn then room0000Conn:Disconnect() room0000Conn = nil end
	if not on then clearRoom0000() return end
	scanArturRooms()
	local map = workspace:FindFirstChild("Map")
	if map then
		room0000Conn = map.DescendantAdded:Connect(function(inst)
			if not room0000On then return end
			if inst.Name == "ArturRoom" then
				task.defer(function()
					local door = inst:FindFirstChild("Door")
					local part = door and door:FindFirstChild("Part")
					if part then highlightArturPart(part) end
				end)
			elseif inst.Name == "Part" and inst:IsA("BasePart") then
				local door = inst.Parent
				local room = door and door.Parent
				if door and door.Name == "Door" and room and room.Name == "ArturRoom" then
					highlightArturPart(inst)
				end
			end
		end)
	end
	task.spawn(function()
		while room0000On do scanArturRooms() task.wait(2.5) end
	end)
end

--==============================================================
-- ESP ITEMS
--==============================================================
local function clearItemHighlights()
	for model, hl in pairs(espItemHighlights) do
		pcall(function()
			if hl then hl:Destroy() end
		end)
	end
	table.clear(espItemHighlights)
end

local function highlightItemModel(model)
	if not espItemsOn then return end
	if not model or not model:IsA("Model") then return end
	if not model.Parent then return end

	local hl = espItemHighlights[model]
	if not hl or not hl.Parent then
		hl = model:FindFirstChild("QuackItemHL")
	end

	if not hl then
		hl = Instance.new("Highlight")
		hl.Name = "QuackItemHL"
		hl.Parent = model
	end

	hl.Adornee = model
	hl.FillColor = Color3.fromRGB(0, 200, 255)
	hl.OutlineColor = Color3.fromRGB(255, 215, 0)
	hl.FillTransparency = 0.45
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Enabled = true

	espItemHighlights[model] = hl
end

local function scanItemSpawns()
	local map = workspace:FindFirstChild("Map")
	if not map then return end

	for _, floor in ipairs(map:GetChildren()) do
		if floor.Name:match("^Floor") then
			for _, desc in ipairs(floor:GetDescendants()) do
				if desc.Name == "ItemSpawns" then
					for _, item in ipairs(desc:GetChildren()) do
						if item:IsA("Model") then
							highlightItemModel(item)
						end
					end
				end
			end
		end
	end
end

local function bindItemsMap(map)
	if espItemsConn then
		espItemsConn:Disconnect()
		espItemsConn = nil
	end

	espItemsConn = map.DescendantAdded:Connect(function(inst)
		if not espItemsOn then return end

		if inst.Name == "ItemSpawns" then
			task.defer(function()
				for _, item in ipairs(inst:GetChildren()) do
					if item:IsA("Model") then
						highlightItemModel(item)
					end
				end
			end)
		elseif inst:IsA("Model") and inst.Parent and inst.Parent.Name == "ItemSpawns" then
			task.defer(function()
				highlightItemModel(inst)
			end)
		end
	end)
end

local function startItemsLoop()
	if espItemsLoopRunning then return end
	espItemsLoopRunning = true

	task.spawn(function()
		while espItemsOn do
			scanItemSpawns()
			task.wait(2)
		end
		espItemsLoopRunning = false
	end)
end

local function setEspItems(on)
	espItemsOn = on

	if espItemsConn then
		espItemsConn:Disconnect()
		espItemsConn = nil
	end

	if espItemsWorkspaceConn then
		espItemsWorkspaceConn:Disconnect()
		espItemsWorkspaceConn = nil
	end

	if not on then
		clearItemHighlights()
		return
	end

	scanItemSpawns()

	local map = workspace:FindFirstChild("Map")
	if map then
		bindItemsMap(map)
	end

	espItemsWorkspaceConn = workspace.ChildAdded:Connect(function(child)
		if not espItemsOn then return end
		if child.Name == "Map" then
			task.defer(function()
				bindItemsMap(child)
				scanItemSpawns()
			end)
		end
	end)

	startItemsLoop()
end

--==============================================================
-- AUTO PICKUP (optimized, Coins priority, cache-based)
--==============================================================
local function getHRP()
	local char = LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function isCoinModel(model)
	if not model then return false end
	local name = model.Name:lower()
	for coinName, _ in pairs(COIN_NAMES) do
		if name:find(coinName) then return true end
	end
	return false
end

local function rebuildCache()
	if not autoPickupOn then return end
	
	local newCache = {}
	local hrp = getHRP()
	if not hrp then
		autoPickupCache = newCache
		return
	end
	
	local map = workspace:FindFirstChild("Map")
	if not map then
		autoPickupCache = newCache
		return
	end
	
	for _, floor in ipairs(map:GetChildren()) do
		if floor.Name:match("^Floor") then
			for _, desc in ipairs(floor:GetDescendants()) do
				if desc.Name == "ItemSpawns" then
					for _, item in ipairs(desc:GetChildren()) do
						if item:IsA("Model") then
							local coin = isCoinModel(item)
							for _, child in ipairs(item:GetDescendants()) do
								if child:IsA("ProximityPrompt") and child.Enabled then
									local part = child.Parent:IsA("BasePart") and child.Parent or child.Parent:FindFirstChildWhichIsA("BasePart")
									if part then
										local dist = (hrp.Position - part.Position).Magnitude
										table.insert(newCache, {
											prompt = child,
											part = part,
											distance = dist,
											isCoin = coin,
										})
									end
								end
							end
						end
					end
				end
			end
		end
	end
	
	autoPickupCache = newCache
end

local function findBestPrompt()
	local hrp = getHRP()
	if not hrp or #autoPickupCache == 0 then return nil end
	
	local bestCoin = nil
	local bestCoinDist = math.huge
	local bestOther = nil
	local bestOtherDist = math.huge
	
	for _, entry in ipairs(autoPickupCache) do
		if not entry.prompt.Enabled then continue end
		if autoPickupCooldown[entry.prompt] then continue end
		
		local dist = (hrp.Position - entry.part.Position).Magnitude
		local maxDist = entry.prompt.MaxActivationDistance > 0 and entry.prompt.MaxActivationDistance or 10
		local pickupRange = maxDist + 2
		
		if dist <= pickupRange then
			if entry.isCoin and dist < bestCoinDist then
				bestCoin = entry
				bestCoinDist = dist
			elseif not entry.isCoin and dist < bestOtherDist then
				bestOther = entry
				bestOtherDist = dist
			end
		end
	end
	
	return bestCoin or bestOther
end

local function firePrompt(prompt)
	if not prompt or not prompt.Parent then return end
	
	pcall(function()
		prompt.Enabled = true
		prompt.RequiresLineOfSight = false
		prompt.MaxActivationDistance = math.huge
		prompt.HoldDuration = 0
	end)
	
	if fireproximityprompt then
		pcall(fireproximityprompt, prompt)
	else
		pcall(function()
			prompt:InputHoldBegin()
			task.wait(0.05)
			prompt:InputHoldEnd()
		end)
	end
	
	autoPickupCooldown[prompt] = true
	task.delay(1.5, function()
		autoPickupCooldown[prompt] = nil
	end)
end

local function pickupTick()
	if not autoPickupOn then return end
	local best = findBestPrompt()
	if best then
		firePrompt(best.prompt)
	end
end

local function setAutoPickup(on)
	autoPickupOn = on
	
	if autoPickupScanConn then
		autoPickupScanConn:Disconnect()
		autoPickupScanConn = nil
	end
	if autoPickupHeartbeatConn then
		autoPickupHeartbeatConn:Disconnect()
		autoPickupHeartbeatConn = nil
	end
	
	if not on then
		autoPickupCache = {}
		table.clear(autoPickupCooldown)
		return
	end
	
	rebuildCache()
	
	autoPickupHeartbeatConn = RunService.Heartbeat:Connect(pickupTick)
	
	local lastScan = 0
	autoPickupScanConn = RunService.Heartbeat:Connect(function()
		if not autoPickupOn then return end
		local now = os.clock()
		if now - lastScan >= 0.7 then
			lastScan = now
			rebuildCache()
		end
	end)
end

--==============================================================
-- FREEZE MEAT
--==============================================================
local function findMeatsModels()
	local models = {}
	local seen = {}
	
	local ok, tagged = pcall(function() return CollectionService:GetTagged("MeatsMonster") end)
	if ok and tagged then
		for _, m in ipairs(tagged) do
			if m:IsDescendantOf(workspace) and not seen[m] then
				seen[m] = true
				table.insert(models, m)
			end
		end
	end
	
	local map = workspace:FindFirstChild("Map")
	if map then
		for _, floor in ipairs(map:GetChildren()) do
			if floor.Name:match("^Floor") then
				local meat = floor:FindFirstChild("Meat")
				if meat then
					local meats = meat:FindFirstChild("meats")
					if meats then
						for _, child in ipairs(meats:GetChildren()) do
							if not seen[child] then
								seen[child] = true
								table.insert(models, child)
							end
						end
					end
				end
			end
		end
	end
	
	local wsMeats = workspace:FindFirstChild("meats")
	if wsMeats then
		for _, child in ipairs(wsMeats:GetChildren()) do
			if not seen[child] then
				seen[child] = true
				table.insert(models, child)
			end
		end
	end
	
	return models
end

local function hookMeatsRaycast()
	if meatsRaycastHooked then return end
	if not hookfunction then return end
	
	meatsRaycastOrig = hookfunction(workspace.Raycast, function(self, origin, direction, params)
		if not freezeMeatOn then
			return meatsRaycastOrig(self, origin, direction, params)
		end
		
		local realResult = meatsRaycastOrig(self, origin, direction, params)
		
		local meats = findMeatsModels()
		for _, meat in ipairs(meats) do
			if meat and meat.Parent then
				for _, desc in ipairs(meat:GetDescendants()) do
					if desc:IsA("BasePart") and desc.Transparency < 1 then
						local toMeat = desc.Position - origin
						if toMeat.Magnitude < 0.1 then
							return meatsRaycastOrig(self, origin, direction, params)
						end
						local dirUnit = direction.Unit
						local dot = dirUnit:Dot(toMeat.Unit)
						
						if dot > 0.85 and toMeat.Magnitude < direction.Magnitude + 5 then
							return {
								Instance = desc,
								Position = desc.Position,
								Distance = toMeat.Magnitude,
								Material = Enum.Material.Plastic,
								Normal = -dirUnit,
							}
						end
						break
					end
				end
			end
		end
		
		return realResult
	end)
	
	meatsRaycastHooked = true
end

local function setFreezeMeat(on)
	freezeMeatOn = on
	if freezeMeatConn then
		freezeMeatConn:Disconnect()
		freezeMeatConn = nil
	end
	if not on then return end
	
	hookMeatsRaycast()
	
	if not oldMeatsNamecall and hookmetamethod then
		oldMeatsNamecall = hookmetamethod(game, "__namecall", function(self, ...)
			local method = getnamecallmethod()
			local args = {...}
			if method == "FireServer" and self == MeatsWatchEvent then
				if args[2] == false then
					return nil
				end
			end
			return oldMeatsNamecall(self, ...)
		end)
	end
	
	freezeMeatConn = RunService.Heartbeat:Connect(function()
		if not freezeMeatOn then return end
		local meats = findMeatsModels()
		for _, meat in ipairs(meats) do
			if meat and meat.Parent then
				pcall(function()
					MeatsWatchEvent:FireServer(meat, true)
				end)
			end
		end
	end)
end

--==============================================================
-- NO STUN
--==============================================================
local function setNoStun(on)
	noStunOn = on
	
	if on then
		if not oldBindAction and hookfunction then
			oldBindAction = hookfunction(ContextActionService.BindAction, function(self, actionName, functionToBind, createTouchButton, ...)
				if actionName == "BlockE" then
					return
				end
				return oldBindAction(self, actionName, functionToBind, createTouchButton, ...)
			end)
		end
		ContextActionService:UnbindAction("BlockE")
	end
end

--==============================================================
-- DISABLE SHAKE
--==============================================================
local function setDisableShake(on)
	shakeOn = on
	
	pcall(function()
		RunService:UnbindFromRenderStep("CameraShaker")
	end)
	
	if on then
		if not oldBindRenderStep and hookfunction then
			oldBindRenderStep = hookfunction(RunService.BindToRenderStep, function(self, name, ...)
				if shakeOn and name == "CameraShaker" then
					return
				end
				return oldBindRenderStep(self, name, ...)
			end)
		end
	end
end

--==============================================================
-- GOD MODE SHKAF (Experimental)
--==============================================================
local function setGodModeShkaf(on)
	godModeShkafOn = on
	
	if godModeShkafConn then
		godModeShkafConn:Disconnect()
		godModeShkafConn = nil
	end
	
	if not on then return end
	
	if not oldNamecallGodMode and hookmetamethod then
		oldNamecallGodMode = hookmetamethod(game, "__namecall", function(self, ...)
			local method = getnamecallmethod()
			local args = {...}
			
			if godModeShkafOn and method == "SetAttribute" then
				if args[1] == "Hided" and args[2] == false then
					return nil
				end
			end
			
			return oldNamecallGodMode(self, ...)
		end)
	end
	
	godModeShkafConn = RunService.Heartbeat:Connect(function()
		if not godModeShkafOn then return end
		
		local char = LocalPlayer.Character
		if char then
			pcall(function()
				char:SetAttribute("Hided", true)
			end)
		end
	end)
end


local chigurConn
local chigurBusy = false

local function pressChigurButton(correct)
	local gui = LocalPlayer.PlayerGui:FindFirstChild("AntonChigur")
	if not gui then
		for _, g in ipairs(LocalPlayer.PlayerGui:GetChildren()) do
			if g:FindFirstChild("Orel") and g:FindFirstChild("Reshka") then
				gui = g
				break
			end
		end
	end
	if not gui then return false end

	local btn
	if correct == 1 then btn = gui:FindFirstChild("Orel")
	elseif correct == 2 then btn = gui:FindFirstChild("Reshka")
	elseif correct == 3 then btn = gui:FindFirstChild("Rebro") end
	if not btn then return false end

	local fired = false
	if getconnections then
		for _, c in ipairs(getconnections(btn.Activated)) do
			pcall(function()
				if c.Fire then c:Fire() fired = true
				elseif c.Function then c.Function() fired = true end
			end)
		end
		for _, c in ipairs(getconnections(btn.MouseButton1Click)) do
			pcall(function()
				if c.Fire then c:Fire() fired = true
				elseif c.Function then c.Function() fired = true end
			end)
		end
	end
	if not fired then
		task.delay(1.5, function()
			if chigurOn then pcall(function() ChigurEvent:FireServer(correct) end) end
		end)
	end

	task.spawn(function()
		task.wait(0.05)
		if not gui or not gui.Parent then return end
		if gui:FindFirstChild("Mouse") then gui.Mouse.Modal = false end
		for _, elem in ipairs(gui:GetDescendants()) do
			if elem:IsA("Frame") or elem:IsA("TextLabel") or elem:IsA("TextButton") or elem:IsA("ImageLabel") then
				pcall(function()
					local tweenInfo = TweenInfo.new(0.1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
					TweenService:Create(elem, tweenInfo, {Position = elem.Position + UDim2.new(0, 0, 0.1, 0)}):Play()
					if elem:IsA("TextLabel") or elem:IsA("TextButton") then
						TweenService:Create(elem, TweenInfo.new(0.1, Enum.EasingStyle.Linear), {TextTransparency = 1, BackgroundTransparency = 1}):Play()
					end
					if elem:IsA("ImageLabel") then
						TweenService:Create(elem, TweenInfo.new(0.1, Enum.EasingStyle.Linear), {ImageTransparency = 1}):Play()
					end
					if elem:IsA("Frame") then
						TweenService:Create(elem, TweenInfo.new(0.1, Enum.EasingStyle.Linear), {BackgroundTransparency = 1}):Play()
					end
				end)
			end
		end
		task.wait(0.1)
		for _, elem in ipairs(gui:GetDescendants()) do
			if elem:IsA("Frame") or elem:IsA("TextLabel") or elem:IsA("TextButton") or elem:IsA("ImageLabel") then
				pcall(function() elem.Visible = false end)
			end
		end
	end)

	return true
end

local function setAutoChigur(on)
	chigurOn = on
	chigurBusy = false
	if chigurConn then chigurConn:Disconnect() chigurConn = nil end
	if not on then return end

	chigurConn = ChigurEvent.OnClientEvent:Connect(function(correct, npc)
		if not chigurOn then return end

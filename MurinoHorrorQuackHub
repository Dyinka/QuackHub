local chgCn, chgBusy = nil, false
local function pressChg(cr)
	local gui = lp.PlayerGui:FindFirstChild("AntonChigur")
	if not gui then
		for _, g in ipairs(lp.PlayerGui:GetChildren()) do
			if g:FindFirstChild("Orel") and g:FindFirstChild("Reshka") then gui = g break end
		end
	end
	if not gui then return false end
	local b
	if cr == 1 then b = gui:FindFirstChild("Orel")
	elseif cr == 2 then b = gui:FindFirstChild("Reshka")
	elseif cr == 3 then b = gui:FindFirstChild("Rebro") end
	if not b then return false end
	local ok = false
	if getconnections then
		for _, c in ipairs(getconnections(b.Activated)) do
			pcall(function() if c.Fire then c:Fire() ok = true elseif c.Function then c.Function() ok = true end end)
		end
		for _, c in ipairs(getconnections(b.MouseButton1Click)) do
			pcall(function() if c.Fire then c:Fire() ok = true elseif c.Function then c.Function() ok = true end end)
		end
	end
	if not ok then
		task.delay(1.5, function()
			if chigOn then pcall(function() chgEv:FireServer(cr) end) end
		end)
	end
	task.spawn(function()
		task.wait(0.05)
		if not gui or not gui.Parent then return end
		if gui:FindFirstChild("Mouse") then gui.Mouse.Modal = false end
		for _, e in ipairs(gui:GetDescendants()) do
			if e:IsA("Frame") or e:IsA("TextLabel") or e:IsA("TextButton") or e:IsA("ImageLabel") then
				pcall(function()
					tw:Create(e, TweenInfo.new(0.1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Position = e.Position + UDim2.new(0, 0, 0.1, 0)}):Play()
					if e:IsA("TextLabel") or e:IsA("TextButton") then
						tw:Create(e, TweenInfo.new(0.1), {TextTransparency = 1, BackgroundTransparency = 1}):Play()
					end
					if e:IsA("ImageLabel") then
						tw:Create(e, TweenInfo.new(0.1), {ImageTransparency = 1}):Play()
					end
					if e:IsA("Frame") then
						tw:Create(e, TweenInfo.new(0.1), {BackgroundTransparency = 1}):Play()
					end
				end)
			end
		end
		task.wait(0.1)
		for _, e in ipairs(gui:GetDescendants()) do
			if e:IsA("Frame") or e:IsA("TextLabel") or e:IsA("TextButton") or e:IsA("ImageLabel") then
				pcall(function() e.Visible = false end)
			end
		end
	end)
	return true
end


local function patchHG(gui)
	if not gui or not instOn then return end
	local am = gui:FindFirstChild("Amount")
	if am and (am:IsA("NumberValue") or am:IsA("IntValue")) then am.Value = 0 end
	local fr = gui:FindFirstChild("Frame")
	local bar = fr and fr:FindFirstChild("Frame")
	if bar and bar:IsA("GuiObject") then bar.Size = UDim2.new(1, 0, 1, 0) end
end

local function watchT(tool)
	if not tool or not tool:IsA("Tool") then return end
	local n = tool.Name:lower()
	if not (n:find("bandag") or n:find("бинт") or tool:FindFirstChild("BandageScript")) then return end
	local function scan(p)
		for _, d in ipairs(p:GetDescendants()) do
			if d.Name == "HealingGui" or d.Name == "Amount" then
				if d.Name == "HealingGui" then
					patchHG(d)
					d:GetPropertyChangedSignal("Enabled"):Connect(function()
						if d.Enabled then patchHG(d) end
					end)
				elseif d:IsA("NumberValue") or d:IsA("IntValue") then
					if instOn then d.Value = 0 end
					d:GetPropertyChangedSignal("Value"):Connect(function()
						if instOn and d.Value > 0 then d.Value = 0 end
					end)
				end
			end
		end
	end
	scan(tool)
	table.insert(instCns, tool.DescendantAdded:Connect(function(i)
		if not instOn then return end
		if i.Name == "HealingGui" then patchHG(i)
		elseif i.Name == "Amount" and (i:IsA("NumberValue") or i:IsA("IntValue")) then i.Value = 0 end
	end))
end

local function setInst(on)
	instOn = on
	for _, c in ipairs(instCns) do pcall(function() c:Disconnect() end) end
	table.clear(instCns)
	if not oldTc and hookfunction then
		oldTc = hookfunction(tw.Create, function(self, inst, info, props)
			if instOn and info and typeof(info) == "TweenInfo" and info.Time and info.Time > 0.05 then
				local ok, inHeal = pcall(function()
					return inst and inst:IsA("GuiObject") and inst:FindFirstAncestor("HealingGui") ~= nil
				end)
				if ok and inHeal then
					info = TweenInfo.new(0, info.EasingStyle, info.EasingDirection)
				end
			end
			return oldTc(self, inst, info, props)
		end)
	end
	if not on then return end
	local function scanCont(c)
		if not c then return end
		for _, t in ipairs(c:GetChildren()) do watchT(t) end
		table.insert(instCns, c.ChildAdded:Connect(function(ch)
			if instOn then watchT(ch) end
		end))
	end
	scanCont(lp:FindFirstChild("Backpack"))
	scanCont(lp.Character)
	table.insert(instCns, lp.CharacterAdded:Connect(function(c)
		task.wait(0.2)
		if instOn then scanCont(c) end
	end))
end

local function ncHook()
	if oldNc then return end
	oldNc = hookmetamethod(game, "__namecall", function(self, ...)
		local m = getnamecallmethod()
		local a = { ... }
		if zaec then
			if m == "FireServer" and typeof(self) == "Instance" and self.Name == "Death" and a[1] == "Zaec" then return nil end
			if m == "InvokeServer" and typeof(self) == "Instance" and self.Name == "Dodging" then return true end
		end
		return oldNc(self, ...)
	end)
end


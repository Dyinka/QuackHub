local function makeOutline(adornee, lineCol)
	local target = adornee
	if adornee:IsA("Model") then
		target = adornee
	elseif not adornee:IsA("BasePart") and not adornee:IsA("Model") then
		return nil
	end
	local hl = Instance.new("Highlight")
	hl.Name = "QH_ESP"
	hl.Adornee = target
	hl.FillTransparency = 1
	hl.OutlineTransparency = 0
	hl.OutlineColor = lineCol
	hl.FillColor = lineCol
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = target
	return hl
end

local function destroyTag(entry)

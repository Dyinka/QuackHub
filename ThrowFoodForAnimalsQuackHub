local function doEquipBest()
	if not resolveRemotes() then return false end
	local ok, result = pcall(function() return Remotes.Invoke("Plot_EquipBest") end)
	if not ok or type(result) ~= "table" then return false, result end
	return result.Ok == true, result
end

local function startEquipLoop()
	if equipLoopRunning then return end
	equipLoopRunning = true
	task.spawn(function()
		while autoEquipBest do
			doEquipBest()
			local waited, d = 0, math.max(0.5, equipBestDelay)
			while autoEquipBest and waited < d do
				task.wait(0.25)
				waited += 0.25
			end
		end
		equipLoopRunning = false
	end)
end

local function setAutoEquipBest(on)
	autoEquipBest = on == true
	if autoEquipBest then
		if not resolveRemotes() then autoEquipBest = false return false end
		startEquipLoop()
		return true
	end
	equipLoopRunning = false
	return true
end


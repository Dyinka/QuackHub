	end
	return true
end

--==============================================================
-- AUTO THROW (cooldown-aware)
--==============================================================
local function hookThrowStart()
	if oldThrowStart or not ThrowController then return false end
	if type(ThrowController.Start) ~= "function" then return false end
	oldThrowStart = ThrowController.Start
	ThrowController.Start = function(...)
		if autoThrow then
			return
		end
		return oldThrowStart(...)
	end
	return true
end

local function unhookThrowStart()
	if not oldThrowStart then return end
	if ThrowController then
		pcall(function() ThrowController.Start = oldThrowStart end)
	end
	oldThrowStart = nil
end

local function ensurePastLine()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end

	if not _crossLineCached then
		local area = workspace:FindFirstChild("StarterArea")
		_crossLineCached = area and area:FindFirstChild("CrossLine")
	end
	if not _crossLineCached then return true end

	if hrp.Position.Z < _crossLineCached.Position.Z - 2 then
		_pastLine = true
		return true
	end

	hrp.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y + 2, _crossLineCached.Position.Z - 8)
	_pastLine = true
	return true
end

local function teleportBackFromLine()
	local area = workspace:FindFirstChild("StarterArea")
	local crossLine = area and area:FindFirstChild("CrossLine")
	if not crossLine then return end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	if hrp.Position.Z < crossLine.Position.Z + 2 then
		hrp.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y + 1, crossLine.Position.Z + 4)
	end
end

local function resetThrowState()
	if not Remotes then return end
	if ClientState and ClientState.Busy then
		ClientState.Busy = nil
		pcall(function() Remotes.Invoke("Throw_Cancel") end)
		task.wait(0.15)
		pcall(function() Remotes.Invoke("Throw_Cancel") end)
	end
end

local function waitForCooldown()
	local elapsed = os.clock() - _lastThrowAt
	local remain = _cooldownEstimate - elapsed
	if remain > 0.05 then
		task.wait(remain + 0.05)
	end
end

local function instantThrowOnce()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false, false end

	resetThrowState()

	if not _pastLine then
		ensurePastLine()
		_pastLine = true
	end
	if _crossLineCached and hrp.Position.Z > _crossLineCached.Position.Z then
		ensurePastLine()
		_pastLine = true
	end

	waitForCooldown()

	if ClientState then ClientState.Busy = "Throw" end
	local wasAnchored = hrp.Anchored
	hrp.Anchored = true

	local complete, caught = false, nil
	local cooldownHit = false
	local sOk, sr, rOk, rr, cOk, cr

	sOk, sr = pcall(function() return Remotes.Invoke("Throw_Start") end)
	if sOk and type(sr) == "table" and sr.Ok == true then
		rOk, rr = pcall(function() return Remotes.Invoke("Throw_Resolve", 1) end)
		if rOk and type(rr) == "table" and rr.Ok == true then
			task.wait(0.4)
			cOk, cr = pcall(function() return Remotes.Invoke("Throw_Complete") end)
			if cOk and ((type(cr) == "table" and cr.Ok == true) or cr == true) then
				complete = true
				caught = rr
				_lastThrowAt = os.clock()
				_cooldownStrikes = 0
			else
				pcall(function() Remotes.Invoke("Throw_Cancel") end)
			end
		else
			pcall(function() Remotes.Invoke("Throw_Cancel") end)
		end
	else
		if sr and sr.Reason == "Cooldown" then
			cooldownHit = true
			_cooldownStrikes = _cooldownStrikes + 1
			if _cooldownStrikes >= 2 then
				_cooldownEstimate = math.min(_cooldownEstimate + 0.3, 3.0)
				_cooldownStrikes = 0
			end
		end
	end

	hrp.Anchored = wasAnchored
	if ClientState then ClientState.Busy = nil end

	if debugThrow then
		warn(string.format(
			"[Throw] Start ok=%s r=%s | Resolve ok=%s model=%s r=%s | Complete ok=%s r=%s | CD est=%.1fs",
			tostring(sOk and sr and sr.Ok), tostring(sr and sr.Reason),
			tostring(rOk and rr and rr.Ok), tostring(rr and rr.ModelName), tostring(rr and rr.Reason),
			tostring(cOk and ((type(cr) == "table" and cr.Ok == true) or cr == true)),
			tostring(cr and cr.Reason),
			_cooldownEstimate
		))
	end

	if complete and notifyWindow and caught and caught.ModelName then
		local name = tostring(caught.ModelName)
		local dist = math.floor(tonumber(caught.Distance) or 0)
		pcall(function()
			notifyWindow:Notify("Caught", name .. " · " .. dist .. "m", 2)
		end)
	end

	return complete, cooldownHit
end

local function startThrowLoop()
	if throwLoopRunning then return end
	throwLoopRunning = true
	task.spawn(function()
		while autoThrow do
			local _, cooldownHit = pcall(instantThrowOnce)
			if cooldownHit then
				task.wait(0.1)
			else
				local waited = 0
				while autoThrow and waited < 0.1 do
					task.wait(0.02)
					waited += 0.02
				end
			end
		end
		throwLoopRunning = false
	end)
end

local function trySetThrowPower()
	if _powerSet or not Remotes then return end
	_powerSet = true
	pcall(function() Remotes.Invoke("Player_SetThrowPower", 999999999) end)
end

local function setAutoThrow(on)
	if on then
		if not resolveThrowMods() then return false end
		if not hookThrowStart() then return false end
		if autoTrain then
			autoTrain = false
			trainLoopRunning = false
			trainClickRunning = false
			if notifyWindow then
				pcall(function()
					notifyWindow:Notify("Auto Train", "Disabled — conflicts with Throw", 3)
				end)
			end
		end
		autoThrow = true
		_pastLine = false
		_crossLineCached = nil
		_powerSet = false
		_lastThrowAt = 0
		_cooldownEstimate = 1.5
		_cooldownStrikes = 0
		trySetThrowPower()
		startThrowLoop()
		return true
	end
	autoThrow = false
	throwLoopRunning = false
	_powerSet = false
	unhookThrowStart()
	_pastLine = false
	_crossLineCached = nil
	pcall(teleportBackFromLine)
	return true
end


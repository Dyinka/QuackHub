local function getTrainingSpot()
	local props = workspace:FindFirstChild("LocalPlotProps")
	if not props then return nil end
	local area = props:FindFirstChild("TrainingArea")
	if not area then return nil end
	local spot = area:FindFirstChild("TrainingSpot")
	if spot and spot:IsA("BasePart") then return spot end
	return nil
end

local function teleportToTraining()
	local spot = getTrainingSpot()
	if not spot then return false end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	hrp.CFrame = spot.CFrame + Vector3.new(0, 3, 0)
	return true
end

local function isOnTrainingCircle()
	local spot = getTrainingSpot()
	if not spot then return false end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	local diff = hrp.Position - spot.Position
	return Vector3.new(diff.X, 0, diff.Z).Magnitude < math.max(spot.Size.Y, spot.Size.Z) / 2 + 2
end

local function clickTapBonus()
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then return end
	local seq = pg:FindFirstChild("TrainingSequence")
	if not seq then return end
	local layer = seq:FindFirstChild("TapBonusLayer")
	if not layer then return end
	local btn = layer:FindFirstChild("TapBonus")
	if not btn or not btn:IsA("ImageButton") then return end
	if not btn.Active then return end

	if type(getconnections) == "function" then
		local ok, conns = pcall(getconnections, btn.Activated)
		if ok and conns then
			for _, c in ipairs(conns) do
				pcall(function()
					if type(c.Fire) == "function" then
						c:Fire()
					elseif type(c.Function) == "function" then
						c.Function()
					end
				end)
			end
			return
		end
	end
	pcall(function() btn:Activate() end)
end

local function canStartTraining()
	if not (Remotes and TrainingController) then return false end
	if ClientState and (ClientState.Busy or ClientState.OfflineOpen) then return false end
	if ClientState and ClientState.TutorialActive then return false end

	local running = false
	pcall(function() running = TrainingController.IsRunning() end)
	return not running
end

local function startTrainClickLoop()
	if trainClickRunning then return end
	trainClickRunning = true
	task.spawn(function()
		while autoTrain do
			pcall(clickTapBonus)
			task.wait(0.1)
		end
		trainClickRunning = false
	end)
end

local function startTrainLoop()
	if trainLoopRunning then return end
	trainLoopRunning = true
	task.spawn(function()
		while autoTrain do
			if canStartTraining() then
				if not isOnTrainingCircle() then
					pcall(teleportToTraining)
					task.wait(0.35)
				end
				if autoTrain and canStartTraining() and isOnTrainingCircle() then
					task.spawn(function()
						pcall(function() TrainingController.Start() end)
					end)
				end
			end
			task.wait(0.5)
		end
		trainLoopRunning = false
	end)
end

local function setAutoTrain(on)
	if on then
		if not resolveTrainMods() then return false end
		if autoThrow then
			autoThrow = false
			throwLoopRunning = false
			_powerSet = false
			unhookThrowStart()
			_pastLine = false
			_crossLineCached = nil
			pcall(teleportBackFromLine)
			if notifyWindow then
				pcall(function()
					notifyWindow:Notify("Auto Throw", "Disabled — conflicts with Train", 3)
				end)
			end
		end
		autoTrain = true
		startTrainLoop()
		startTrainClickLoop()
		return true
	end
	autoTrain = false
	trainLoopRunning = false
	trainClickRunning = false
	return true
end


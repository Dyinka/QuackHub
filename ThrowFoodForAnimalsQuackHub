local function loadLibrary()
	local url = "https://raw.githubusercontent.com/Dyinka/QuackUI/refs/heads/main/QuackUI.lua?t=" .. tostring(os.clock())
	local src
	local okGet, getRes = pcall(function() return game:HttpGet(url) end)
	if okGet and type(getRes) == "string" and #getRes > 100 then
		src = getRes
	else
		okGet, getRes = pcall(function()
			return game:HttpGet("https://raw.githubusercontent.com/Dyinka/QuackUI/refs/heads/main/QuackUI.lua")
		end)
		if okGet and type(getRes) == "string" and #getRes > 100 then
			src = getRes
		end
	end
	if not src then
		error("[Hub] HttpGet failed — cannot download QuackUI.")
	end
	local loader = loadstring or load
	if type(loader) ~= "function" then
		error("[Hub] loadstring/load is nil in this executor.")
	end
	local okLoad, fnOrErr, errMsg = pcall(loader, src, "=QuackUI")
	if not okLoad then
		error("[Hub] loadstring threw: " .. tostring(fnOrErr))
	end
	if type(fnOrErr) ~= "function" then
		error("[Hub] QuackUI syntax error: " .. tostring(errMsg))
	end
	local okRun, libOrErr = pcall(fnOrErr)
	if not okRun then
		error("[Hub] QuackUI runtime error: " .. tostring(libOrErr))
	end
	if type(libOrErr) ~= "table" then
		error("[Hub] QuackUI did not return Library table.")
	end
	return libOrErr
end


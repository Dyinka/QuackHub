--==============================================================
-- MONEY PARSER (fallback)
--==============================================================
local MONEY_SUFFIX = {
	K=1e3, M=1e6, B=1e9, T=1e12,
	Qa=1e15, Qi=1e18, Sx=1e21, Sp=1e24,
	Oc=1e27, No=1e30, Dc=1e33, Ud=1e36,
	Dd=1e39, Td=1e42, Qad=1e45, Qid=1e48,
}

local function parseMoney(v)
	if type(v) == "number" then return v end
	if type(v) ~= "string" then return 0 end
	v = v:gsub("%s", ""):gsub(",", "")
	local num, suf = v:match("^([%d%.eE%+%-]+)(%a*)$")
	if num then
		local n = tonumber(num) or 0
		if suf ~= "" and MONEY_SUFFIX[suf] then return n * MONEY_SUFFIX[suf] end
		return n
	end
	return tonumber(v) or 0
end

local function getMoney()
	if DataController then
		local ok, v = pcall(function() return DataController:Get("Money") end)
		if ok and type(v) == "number" then return v end
	end
	local ls = LocalPlayer:FindFirstChild("leaderstats")
	local m = ls and ls:FindFirstChild("Money")
	if m and type(m.Value) == "number" then return m.Value end
	return parseMoney(m and m.Value or "0")
end


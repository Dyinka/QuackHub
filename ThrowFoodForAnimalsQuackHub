--==============================================================
-- AUTO BUY FOOD
--==============================================================
local function isFoodOwned(idx)
	local ok, v = pcall(function()
		return DataController:GetPath("OwnedFoods." .. idx)
	end)
	return ok and v == true
end

local function isFoodLocked(idx)
	local ok, v = pcall(function()
		return FoodsConfig.IsLocked(idx)
	end)
	return ok and v == true
end

local function tryBuyFood(idx)
	if not resolveRemotes() then return false end
	local ok, res = pcall(function() return Remotes.Invoke("Shop_Buy", idx) end)
	if not ok then return false end
	return (type(res) == "table" and res.Ok == true) or res == true
end

local function tryEquipFood(idx)
	if not resolveRemotes() then return false end
	local ok, res = pcall(function() return Remotes.Invoke("Shop_Equip", idx) end)
	if not ok then return false end
	return (type(res) == "table" and res.Ok == true) or res == true
end

local function buildBuyList(money)
	local list = {}
	if not FoodsConfig then return list end
	for i = 1, FoodsConfig.CountAll() do
		if not isFoodOwned(i) and not isFoodLocked(i) then
			local f = FoodsConfig.GetAny(i)
			if f and type(f.Price) == "number" and money >= f.Price then
				list[#list + 1] = {
					idx   = i,
					price = f.Price,
					tier  = f.Tier or 99,
					name  = f.Name or tostring(i),
				}
			end
		end
	end
	table.sort(list, function(a, b)
		if a.tier ~= b.tier then return a.tier < b.tier end
		return a.price < b.price
	end)
	return list
end

local function buyPass()
	if not resolveBuyMods() then return 0 end
	local money = getMoney()
	local list = buildBuyList(money)
	local bought = 0
	for _, c in ipairs(list) do
		if not autoBuy then break end
		money = getMoney()
		if money < c.price then break end
		if isFoodOwned(c.idx) then continue end
		if tryBuyFood(c.idx) then
			bought += 1
			tryEquipFood(c.idx)
		end
		task.wait(buyDelay)
	end
	return bought
end

local function startBuyLoop()
	if buyLoopRunning then return end
	buyLoopRunning = true
	task.spawn(function()
		while autoBuy do
			pcall(buyPass)
			local w = 0
			while autoBuy and w < buyLoopWait do
				task.wait(0.25)
				w += 0.25
			end
		end
		buyLoopRunning = false
	end)
end

local function setAutoBuy(on)
	if on then
		if not resolveBuyMods() then return false end
		autoBuy = true
		startBuyLoop()
		return true
	end
	autoBuy = false
	buyLoopRunning = false
	return true
end

--==============================================================
-- AUTO SELL (rarity + mutation)
--==============================================================
local function rarityFromModelName(modelName)
	if type(modelName) ~= "string" or modelName == "" then return nil end
	if not AnimalEconomy or type(AnimalEconomy.Get) ~= "function" then return nil end
	local info = AnimalEconomy.Get(modelName)
	if type(info) == "table" and type(info.Rarity) == "string" then
		return info.Rarity
	end
	local list = AnimalEconomy.List
	if type(list) == "table" then
		local row = list[modelName]
		if type(row) == "table" and type(row.Rarity) == "string" then
			return row.Rarity
		end
	end
	return nil
end

local function getEntryModelName(entry)
	if type(entry) ~= "table" then return nil end
	if type(entry.ModelName) == "string" and entry.ModelName ~= "" then
		return entry.ModelName
	end
	if type(entry.Name) == "string" then return entry.Name end
	if type(entry.name) == "string" then return entry.name end
	return nil
end

local function hasMutationFilter()
	return next(sellMutations) ~= nil
end

local function mutationAllowed(entry)
	if not hasMutationFilter() then return true end
	local mut = entry and entry.Mutation
	if type(mut) == "string" and mut ~= "" then
		return sellMutations[mut] == true
	end
	return sellMutations["None"] == true
end

local function doAutoSellPass()
	if not resolveSellMods() then return 0 end
	local animals
	pcall(function() animals = DataController:Get("Animals") end)
	if type(animals) ~= "table" then return 0 end
	local sold = 0
	for id, entry in pairs(animals) do
		if not autoSell then break end
		if type(entry) ~= "table" then continue end
		if entry.Placed == true then continue end
		if entry.Bought == true then continue end
		local modelName = getEntryModelName(entry)
		local rar = rarityFromModelName(modelName)
		if not rar or not sellRarities[rar] then continue end
		if not mutationAllowed(entry) then continue end
		local ok, res = pcall(function()
			return Remotes.Invoke("Plot_SellAnimal", id)
		end)
		if ok and type(res) == "table" and res.Ok then
			sold += 1
			task.wait(0.15)
		end
	end
	return sold
end

local function startSellLoop()
	if sellLoopRunning then return end
	sellLoopRunning = true
	task.spawn(function()
		while autoSell do
			doAutoSellPass()
			local waited, d = 0, math.max(0.5, sellDelay)
			while autoSell and waited < d do
				task.wait(0.25)
				waited += 0.25
			end
		end
		sellLoopRunning = false
	end)
end

local function setAutoSell(on)
	autoSell = on == true
	if autoSell then
		if not resolveSellMods() then autoSell = false return false end
		startSellLoop()
		return true
	end
	sellLoopRunning = false
	return true
end


local function controllersFolder()
	local ps = LocalPlayer:FindFirstChild("PlayerScripts")
	local client = ps and ps:FindFirstChild("Client")
	return client and client:FindFirstChild("Controllers")
end

local function resolveRemotes()
	if Remotes then return true end
	return pcall(function()
		Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
	end) and Remotes ~= nil
end

local function resolveThrowMods()
	resolveRemotes()
	pcall(function()
		local folder = controllersFolder()
		if folder then
			if not ClientState then
				ClientState = require(folder:WaitForChild("ClientState"))
			end
			if not ThrowController then
				ThrowController = require(folder:WaitForChild("ThrowController"))
			end
		end
	end)
	return Remotes ~= nil and ClientState ~= nil and ThrowController ~= nil
end

